
<?php
$this->headTitle('Horario de Cursos');
$role = $this->layout()->role;
?>
<div class="col-lg-12">
    <div class="panel panel-<?= (empty($role) ? 'blue' : ($role->hasAdminRole() ? 'green' : 'blue')) ?>">
