<!-- Toast Service -->
<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>

<script>
$(document).ready(function() {

    function guardarMadrinaPadrino() {
        const tipo   = $('#inputTipo').val().trim();
        const nombre = $('#inputNombre').val().trim();
        const titulo = $('#inputTitulo').val().trim();

        if (!tipo) {
            ToastService.warning('Debe seleccionar si es madrina o padrino.');
            return;
        }
        if (!nombre) {
            ToastService.warning('Debe ingresar el nombre.');
            return;
        }
        if (!titulo) {
            ToastService.warning('Debe ingresar el título profesional.');
            return;
        }

        const $confirmBtn = $('#btnConfirmarMadrina');
        $confirmBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

        $.post('<?= $this->url("student-graduation", ["action" => "guardar-madrina-padrino"]) ?>', {
            tipo: tipo,
            nombre: nombre,
            titulo_profesional: titulo
        }, function(res) {
            $confirmBtn.prop('disabled', false).html('<i class="fa fa-check"></i> Guardar');
            if (res.success) {
                const texto = titulo
                    ? titulo + ' ' + nombre
                    : nombre;
                $('#madrinaTexto').text(texto);
                $('#madrinaEdit').hide();
                $('#madrinaDisplay').show();
                ToastService.success(res.message || 'Datos guardados correctamente.');
            } else {
                ToastService.error(res.message || 'No se pudo guardar.');
            }
        }).fail(function() {
            $confirmBtn.prop('disabled', false).html('<i class="fa fa-check"></i> Guardar');
            ToastService.error('Error de conexión al guardar.');
        });
    }

    $('#btnConfirmarMadrina').on('click', guardarMadrinaPadrino);

    $('#inputNombre, #inputTitulo').on('keydown', function(e) {
        if (e.which === 13) {
            e.preventDefault();
            guardarMadrinaPadrino();
        }
    });

    $('#btnEditarMadrina').on('click', function() {
        $('#madrinaDisplay').hide();
        $('#madrinaEdit').show();
        $('#inputTipo').focus();
    });
});
</script>
