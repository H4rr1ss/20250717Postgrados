<script>
(function() {
    'use strict';

    function post(url, data, cb) {
        var fd = new FormData();
        if (data) {
            Object.keys(data).forEach(function(k) { fd.append(k, data[k]); });
        }
        var xhr = new XMLHttpRequest();
        xhr.open('POST', url);
        xhr.onload = function() {
            try {
                var r = JSON.parse(xhr.responseText);
                cb(r);
            } catch (e) {
                alert('Respuesta inválida del servidor');
            }
        };
        xhr.send(fd);
    }

    var formProf = document.getElementById('form-seleccionar-prof');
    if (formProf) {
        var selProf    = document.getElementById('sel-profesional');
        var detalle    = document.getElementById('prof-detalle');
        var detNombre  = document.getElementById('prof-detalle-nombre');
        var detCorreo  = document.getElementById('prof-detalle-correo');
        var detCorreoV = document.getElementById('prof-detalle-correo-val');
        var detTel     = document.getElementById('prof-detalle-telefono');
        var detTelV    = document.getElementById('prof-detalle-telefono-val');

        function mostrarDetalle(id) {
            if (typeof profData === 'undefined') return;
            var p = profData[id];
            if (!p) { detalle.style.display = 'none'; return; }
            detNombre.textContent = p.nombre;
            if (p.correo) {
                detCorreoV.textContent = p.correo;
                detCorreo.style.display = 'block';
            } else {
                detCorreo.style.display = 'none';
            }
            if (p.telefono) {
                detTelV.textContent = p.telefono;
                detTel.style.display = 'block';
            } else {
                detTel.style.display = 'none';
            }
            detalle.style.display = 'block';
        }

        // Mostrar detalle al cargar si ya hay uno seleccionado
        if (selProf && parseInt(selProf.value, 10) > 0) {
            mostrarDetalle(parseInt(selProf.value, 10));
        }

        if (selProf) {
            selProf.addEventListener('change', function() {
                mostrarDetalle(parseInt(selProf.value, 10) || 0);
            });
        }

        formProf.addEventListener('submit', function(e) {
            e.preventDefault();
            var id = parseInt(selProf.value, 10) || 0;
            if (id <= 0) {
                alert('Debes seleccionar un profesional de la lista.');
                return;
            }
            post('<?= $urlSeleccionar ?>', { cod_profesional: id }, function(r) {
                alert(r.message);
                if (r.success) location.reload();
            });
        });
    }

})();
</script>
