<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>
<script>
(function () {
    'use strict';

    /* ── Subir evidencia ── */
    var formSubir = document.getElementById('form-subir-evidencia');
    if (formSubir) {
        formSubir.addEventListener('submit', function (e) {
            e.preventDefault();
            var btn = formSubir.querySelector('button[type="submit"]');
            btn.disabled = true;
            var fd = new FormData(formSubir);
            fetch(formSubir.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            })
            .then(function (res) { return res.json(); })
            .then(function (json) {
                if (json.success) {
                    ToastService.success(json.message || 'Evidencia agregada correctamente.');
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    ToastService.error(json.message || 'No se pudo agregar la evidencia.');
                    btn.disabled = false;
                }
            })
            .catch(function () {
                ToastService.error('Error de comunicación. Intenta de nuevo.');
                btn.disabled = false;
            });
        });
    }

    /* ── Eliminar evidencia ── */
    document.querySelectorAll('.form-eliminar-evidencia').forEach(function (f) {
        f.addEventListener('submit', function (e) {
            e.preventDefault();
            ConfirmService.confirm('¿Eliminar esta entrada de la bitácora?', function() {
                var btn = f.querySelector('button[type="submit"]');
            btn.disabled = true;
            var fd = new FormData(f);
            fetch(f.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            })
            .then(function (res) { return res.json(); })
            .then(function (json) {
                if (json.success) {
                    ToastService.success(json.message || 'Entrada eliminada.');
                    setTimeout(function () { location.reload(); }, 1000);
                } else {
                    ToastService.error(json.message || 'No se pudo eliminar.');
                    btn.disabled = false;
                }
            })
            .catch(function () {
                ToastService.error('Error de comunicación. Intenta de nuevo.');
                btn.disabled = false;
            });
            });
        });
    });
}());
</script>
