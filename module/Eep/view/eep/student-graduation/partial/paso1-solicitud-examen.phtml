<script>
$(document).ready(function() {
    
    // Ver documento
    $('.btn-ver-documento').on('click', function() {
        const link = $(this).data('link');
        
        if (!link) {
            alert('ERROR: No se encontró el enlace del documento');
            return;
        }
        
        // Abrir en nueva pestaña
        window.open(link, '_blank');
    });
    
    // Subir documento
    $('.btn-subir-documento').on('click', function() {
        const $btn = $(this);
        const formatos = $btn.data('formatos');
        const codRequisito = $btn.data('requisito');
        
        // Crear input file dinámicamente
        const $fileInput = $('<input type="file" style="display:none">');
        
        // Asegurar que las extensiones tengan punto
        const formatosConPunto = formatos.split(',').map(f => {
            const ext = f.trim();
            return ext.startsWith('.') ? ext : '.' + ext;
        }).join(',');
        
        $fileInput.attr('accept', formatosConPunto);
        
        // Agregar al DOM
        $('body').append($fileInput);
        
        // Manejar selección de archivo
        $fileInput.on('change', function() {
            const file = this.files[0];
            
            if (!file) {
                $(this).remove();
                return;
            }
            
            // Validar extensión
            const nombreArchivo = file.name.toLowerCase();
            const formatosArray = formatos.toLowerCase().split(',').map(f => f.trim());
            const extension = '.' + nombreArchivo.split('.').pop();
            
            let formatoValido = false;
            for (let i = 0; i < formatosArray.length; i++) {
                const formato = formatosArray[i];
                if (formato.includes('/')) {
                    // Es un MIME type (ej: image/png)
                    if (file.type === formato) {
                        formatoValido = true;
                        break;
                    }
                } else {
                    // Es una extensión (ej: .pdf)
                    if (extension === formato || nombreArchivo.endsWith(formato)) {
                        formatoValido = true;
                        break;
                    }
                }
            }
            
            if (!formatoValido) {
                alert(`Formato no permitido.\nFormatos aceptados: ${formatos}\nArchivo seleccionado: ${file.name}`);
                $(this).remove();
                return;
            }
            
            // Si todo está bien, confirmar subida
            if (confirm(`¿Desea subir el archivo "${file.name}"?`)) {
                subirDocumento(file, codRequisito);
            }
            
            // Remover input
            $(this).remove();
        });
        
        // Trigger click para abrir selector
        $fileInput.trigger('click');
    });
    
    // Función para subir documento vía AJAX
    function subirDocumento(file, codRequisito) {
        const formData = new FormData();
        formData.append('archivo', file);
        formData.append('cod_requisito', codRequisito);
        
        // Crear overlay de carga
        const $overlay = $('<div id="upload-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;"></div>');
        const $loader = $('<div style="background:#fff;padding:30px 50px;border-radius:10px;text-align:center;"><i class="fa fa-spinner fa-spin fa-3x" style="color:#1a3c6b;margin-bottom:15px;"></i><p style="margin:0;font-size:16px;color:#333;">Subiendo documento...<br><small>Por favor espere</small></p></div>');
        $overlay.append($loader);
        $('body').append($overlay);
        
        // Realizar petición AJAX
        $.ajax({
            url: '<?= $this->url("student-graduation", ["action" => "subir-documento"]) ?>',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                $overlay.remove();
                console.log("Respuesta del servidor:", response);
                if (response.success) {
                    // location.reload();
                    console.warn("TODO OCURRIO COMO DEBERIA DE SER. ARCHIVO CARGADO CON EXIñTO")
                } else {
                    alert('✗ ERROR\n\n' + (response.message || 'No se pudo subir el documento'));
                }
            },
            error: function(xhr, status, error) {
                $overlay.remove();
                alert('✗ ERROR DE SERVIDOR\n\nOcurrió un error al subir el documento:\n' + error);
            }
        });
    }
    
});
</script>