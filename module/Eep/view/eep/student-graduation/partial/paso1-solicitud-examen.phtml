/**
 * Función para determinar el estado y metadatos de un documento
 * basado en las columnas de la consulta SQL
 */
function determinarEstadoDocumento($req) {
    $codDocumento = $req['cod_documento'];
    $estadoRevision = $req['estado_revision'];
    $fechaRevision = $req['fecha_revision'];
    
    // Sin documento subido
    if ($codDocumento === null) {
        return [
            'estado' => 'PENDIENTE DE SUBIR',
            'clase' => 'badge-pendiente',
            'icono' => 'fa-paperclip',
            'botones' => ['subir'],
            'fecha' => null
        ];
    }
    
    // Documento enviado pero pendiente de revisión
    if ($estadoRevision === null) {
        return [
            'estado' => 'PENDIENTE DE REVISIÓN',
            'clase' => 'badge-pendiente-revision',
            'icono' => 'fa-clock-o',
            'botones' => ['ver'],
            'fecha' => null
        ];
    }
    
    // Documento rechazado
    if ($estadoRevision === 'rechazado') {
        return [
            'estado' => 'RECHAZADO',
            'clase' => 'badge-rechazado',
            'icono' => 'fa-times-circle',
            'botones' => ['razon', 'subir'],
            'fecha' => null
        ];
    }
    
    // Documento aceptado/aprobado
    if ($estadoRevision === 'aprobado' || $estadoRevision === 'aceptado') {
        $fechaFormateada = $fechaRevision ? date('d/m/Y', strtotime($fechaRevision)) : null;
        return [
            'estado' => 'ACEPTADO',
            'clase' => 'badge-aceptado',
            'icono' => 'fa-check-circle',
            'botones' => ['ver'],
            'fecha' => $fechaFormateada
        ];
    }
    
    // Estado desconocido
    return [
        'estado' => 'DESCONOCIDO',
        'clase' => 'badge-pendiente',
        'icono' => 'fa-question-circle',
        'botones' => [],
        'fecha' => null
    ];
}

// Procesar requisitos de la base de datos
$documentos = [];
if (!empty($requisitos)) {
    foreach ($requisitos as $req) {
        $metadatos = determinarEstadoDocumento($req);
        
        $documentos[] = [
            'cod_requisito' => $req['cod_requisito'],
            'cod_documento' => $req['cod_documento'],
            'titulo' => $req['nombre_requisito'],
            'desc' => $req['descripcion'],
            'estado' => $metadatos['estado'],
            'clase' => $metadatos['clase'],
            'icono' => $metadatos['icono'],
            'botones' => $metadatos['botones'],
            'fecha' => $metadatos['fecha'],
            'motivo_rechazo' => $req['motivo_rechazo'] ?? null,
            'url_ver' => $req['url_ver'] ?? null,
            'formatos_permitidos' => $req['formatos_permitidos'],
            'tamano_max_mb' => $req['tamano_max_mb']
        ];
    }
}
