<script>
$(document).ready(function() {
    // ── Guardar tema de tesis ─────────────────────────────────────
    $('#btnGuardarTema').on('click', function() {
        const tema = $('#temaTesis').val().trim();
        const btn = $(this);
        
        if (!tema) {
            ToastService.warning('Debe ingresar el título de su trabajo de graduación.');
            return;
        }
        
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
        
        $.ajax({
            url: '<?= $this->url("student-graduation", ["action" => "guardar-tema-tesis"]) ?>',
            type: 'POST',
            data: { tema_tesis: tema },
            success: function(response) {
                if (response.success) {
                    ToastService.success(response.message);
                    setTimeout(function() {
                        window.location.reload();
                    }, 1500);
                } else {
                    ToastService.error(response.message);
                }
            },
            error: function() {
                ToastService.error('Error de comunicación con el servidor.');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar');
            }
        });
    });

});
</script>
