<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
<script>
(function() {
    'use strict';

    function postForm(url, formEl, onSuccess) {
        var fd = new FormData(formEl);
        var xhr = new XMLHttpRequest();
        xhr.open('POST', url);
        xhr.onload = function() {
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.status === 'success' || resp.success === true) {
                    onSuccess(resp);
                } else {
                    alert(resp.message || 'Operación fallida');
                }
            } catch (e) {
                alert('Respuesta inválida del servidor');
            }
        };
        xhr.send(fd);
    }

    function postData(url, params, onSuccess) {
        var fd = new FormData();
        Object.keys(params).forEach(function(k) { fd.append(k, params[k]); });
        var xhr = new XMLHttpRequest();
        xhr.open('POST', url);
        xhr.onload = function() {
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.status === 'success' || resp.success === true) {
                    onSuccess(resp);
                } else {
                    alert(resp.message || 'Operación fallida');
                }
            } catch (e) {
                alert('Respuesta inválida del servidor');
            }
        };
        xhr.send(fd);
    }

    // ---------- Instrucciones (Summernote WYSIWYG) - Parte 1 y Parte 2 ----------
    var summernoteConfig = {
        height: 250,
        minHeight: 150,
        maxHeight: 400,
        toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'italic', 'underline', 'clear']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['insert', ['link']],
            ['view', ['codeview', 'help']]
        ],
        styleTags: ['p', 'h4', 'h5', 'h6']
    };

    // Inicializar Summernote para Parte 1
    if (typeof $ !== 'undefined' && $.fn.summernote) {
        $('#summernote-instrucciones-parte1').summernote(Object.assign({}, summernoteConfig, {
            callbacks: {
                onChange: function(contents) {
                    document.getElementById('html-instrucciones-parte1').value = contents;
                }
            }
        }));

        // Inicializar Summernote para Parte 2
        $('#summernote-instrucciones-parte2').summernote(Object.assign({}, summernoteConfig, {
            callbacks: {
                onChange: function(contents) {
                    document.getElementById('html-instrucciones-parte2').value = contents;
                }
            }
        }));
    }

    // Handler para ambos formularios de instrucciones
    document.querySelectorAll('.form-instrucciones').forEach(function(formInstr) {
        formInstr.addEventListener('submit', function(e) {
            e.preventDefault();
            var parte = formInstr.dataset.parte;
            // Obtener HTML del editor Summernote correspondiente
            if (typeof $ !== 'undefined' && $.fn.summernote) {
                var editorId = '#summernote-instrucciones-parte' + parte;
                var hiddenId = 'html-instrucciones-parte' + parte;
                document.getElementById(hiddenId).value = $(editorId).summernote('code');
            }
            postForm('<?= $urlGuardarInstrucciones ?>', formInstr, function(r) {
                alert(r.message);
            });
        });
    });

    // ---------- Documentos soporte ----------
    var formDoc = document.getElementById('form-subir-doc');
    if (formDoc) {
        formDoc.addEventListener('submit', function(e) {
            e.preventDefault();
            postForm('<?= $urlSubirDoc ?>', formDoc, function() { location.reload(); });
        });
    }
    document.querySelectorAll('.btn-del-doc').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!confirm('¿Eliminar este documento?')) return;
            postData('<?= $urlEliminarDoc ?>', { cod_documento: btn.dataset.id }, function() { location.reload(); });
        });
    });

    // ---------- Profesionales ----------
    var formProf = document.getElementById('form-prof');
    if (formProf) {
        formProf.addEventListener('submit', function(e) {
            e.preventDefault();
            postForm('<?= $urlGuardarProf ?>', formProf, function() { location.reload(); });
        });
    }
    var btnProfReset = document.getElementById('btn-prof-reset');
    var profEditingIndicator = formProf.querySelector('.form-editing-indicator');
    
    function setProfEditMode(isEditing) {
        if (isEditing) {
            formProf.classList.add('prof-editing');
            formProf.setAttribute('data-mode', 'edit');
            if (profEditingIndicator) profEditingIndicator.style.display = 'block';
        } else {
            formProf.classList.remove('prof-editing');
            formProf.setAttribute('data-mode', 'create');
            if (profEditingIndicator) profEditingIndicator.style.display = 'none';
        }
    }
    
    if (btnProfReset) {
        btnProfReset.addEventListener('click', function() {
            formProf.reset();
            formProf.elements['cod_profesional'].value = 0;
            setProfEditMode(false);
        });
    }
    document.querySelectorAll('.btn-edit-prof').forEach(function(btn) {
        btn.addEventListener('click', function() {
            formProf.elements['cod_profesional'].value = btn.dataset.id;
            formProf.elements['nombre_completo'].value = btn.dataset.nombre;
            formProf.elements['correo'].value          = btn.dataset.correo;
            formProf.elements['telefono'].value        = btn.dataset.telefono;
            setProfEditMode(true);
            formProf.scrollIntoView({ behavior: 'smooth' });
        });
    });
    document.querySelectorAll('.btn-del-prof').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!confirm('¿Desactivar este profesional?')) return;
            postData('<?= $urlEliminarProf ?>', { cod_profesional: btn.dataset.id }, function() { location.reload(); });
        });
    });

    // ---------- Cartas ----------
    var formCarta = document.getElementById('form-carta');
    if (formCarta) {
        formCarta.addEventListener('submit', function(e) {
            e.preventDefault();
            postForm('<?= $urlSubirCarta ?>', formCarta, function() { location.reload(); });
        });
    }
    document.querySelectorAll('.btn-del-carta').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!confirm('¿Eliminar esta carta?')) return;
            postData('<?= $urlEliminarCarta ?>', { cod_carta: btn.dataset.id }, function() { location.reload(); });
        });
    });

    // ---------- Junta directiva ----------
    var formMiembro = document.getElementById('form-miembro');
    var miembroEditingIndicator = formMiembro.querySelector('.form-editing-indicator');
    
    function setMiembroEditMode(isEditing) {
        if (isEditing) {
            formMiembro.classList.add('miembro-editing');
            formMiembro.setAttribute('data-mode', 'edit');
            if (miembroEditingIndicator) miembroEditingIndicator.style.display = 'block';
        } else {
            formMiembro.classList.remove('miembro-editing');
            formMiembro.setAttribute('data-mode', 'create');
            if (miembroEditingIndicator) miembroEditingIndicator.style.display = 'none';
        }
    }
    
    if (formMiembro) {
        formMiembro.addEventListener('submit', function(e) {
            e.preventDefault();
            postForm('<?= $urlGuardarMiembro ?>', formMiembro, function() { location.reload(); });
        });
    }
    var btnMiembroReset = document.getElementById('btn-miembro-reset');
    if (btnMiembroReset) {
        btnMiembroReset.addEventListener('click', function() {
            formMiembro.reset();
            formMiembro.elements['cod_miembro'].value = 0;
            setMiembroEditMode(false);
        });
    }
    document.querySelectorAll('.btn-edit-miembro').forEach(function(btn) {
        btn.addEventListener('click', function() {
            formMiembro.elements['cod_miembro'].value     = btn.dataset.id;
            formMiembro.elements['nombre_completo'].value = btn.dataset.nombre;
            formMiembro.elements['puesto'].value          = btn.dataset.puesto;
            setMiembroEditMode(true);
            formMiembro.scrollIntoView({ behavior: 'smooth' });
        });
    });
    document.querySelectorAll('.btn-del-miembro').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!confirm('¿Eliminar este miembro?')) return;
            postData('<?= $urlEliminarMiembro ?>', { cod_miembro: btn.dataset.id }, function() { location.reload(); });
        });
    });

    // ---------- File picker: mostrar nombre de archivo seleccionado ----------
    document.querySelectorAll('.file-picker-input').forEach(function(input) {
        input.addEventListener('change', function() {
            var wrapper = input.closest('.file-picker-wrapper');
            if (wrapper) {
                var nameDisplay = wrapper.querySelector('.file-picker-name');
                if (nameDisplay) {
                    if (input.files && input.files.length > 0) {
                        nameDisplay.textContent = input.files[0].name;
                        nameDisplay.classList.remove('text-muted');
                        nameDisplay.style.color = '#31708f';
                        nameDisplay.style.fontWeight = '600';
                    } else {
                        nameDisplay.textContent = 'Sin archivo seleccionado';
                        nameDisplay.classList.add('text-muted');
                        nameDisplay.style.color = '';
                        nameDisplay.style.fontWeight = '';
                    }
                }
            }
        });
    });
})();
</script>

