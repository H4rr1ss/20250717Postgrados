<!-- Toast Service -->
<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>

<script>
$(document).ready(function() {
    var timerBusqueda = null;
    var estudianteSeleccionado = null;

    // ── Búsqueda con debounce ──────────────────────────────────
    $('#inputBusqueda').on('input', function() {
        var termino = $(this).val().trim();
        clearTimeout(timerBusqueda);

        if (termino.length < 2) {
            $('#resultadosBusqueda').hide();
            $('#sinResultados').hide();
            return;
        }

        timerBusqueda = setTimeout(function() {
            buscarEstudiantes(termino);
        }, 400);
    });

    function buscarEstudiantes(termino) {
        $('#iconoBusqueda').hide();
        $('#iconoCargando').show();

        $.ajax({
            url: '<?= $this->url("examen", ["action" => "buscar-estudiante"]) ?>',
            type: 'GET',
            dataType: 'json',
            data: { q: termino },
            success: function(response) {
                $('#iconoCargando').hide();
                $('#iconoBusqueda').show();

                if (response.status === 'success' && response.data.length > 0) {
                    mostrarResultados(response.data);
                } else {
                    $('#resultadosBusqueda').hide();
                    $('#sinResultados').show();
                }
            },
            error: function() {
                $('#iconoCargando').hide();
                $('#iconoBusqueda').show();
                ToastService.error('Error al buscar estudiantes.');
            }
        });
    }

    function mostrarResultados(estudiantes) {
        var tbody = $('#tablaResultados');
        tbody.empty();
        $('#sinResultados').hide();

        $.each(estudiantes, function(i, est) {
            var fila = $('<tr>')
                .attr('data-cod-usuario', est.cod_usuario)
                .attr('data-registro', est.registro_academico || '')
                .attr('data-nombre', est.nombre_completo || '')
                .attr('data-carrera', est.carrera || 'N/A')
                .attr('data-correo', est.correo || '')
                .attr('data-cui', est.cui || '');

            fila.append('<td>' + (est.registro_academico || '-') + '</td>');
            fila.append('<td>' + escapeHtml(est.nombre_completo || '-') + '</td>');
            fila.append('<td>' + escapeHtml(est.carrera || 'N/A') + '</td>');
            fila.append('<td>' + escapeHtml(est.correo || '-') + '</td>');
            fila.append('<td style="text-align:center;"><button type="button" class="btn-seleccionar"><i class="fa fa-check"></i></button></td>');

            tbody.append(fila);
        });

        $('#resultadosBusqueda').show();
    }

    // ── Seleccionar estudiante ─────────────────────────────────
    $(document).on('click', '#tablaResultados tr, #tablaResultados .btn-seleccionar', function(e) {
        e.stopPropagation();
        var fila = $(this).closest('tr');
        var cod = fila.data('cod-usuario');
        var nombre = fila.data('nombre');
        var registro = fila.data('registro');
        var carrera = fila.data('carrera');
        var correo = fila.data('correo');
        var cui = fila.data('cui');

        // Marcar fila como seleccionada
        $('#tablaResultados tr').removeClass('seleccionado');
        fila.addClass('seleccionado');

        // Llenar datos
        $('#codUsuarioSeleccionado').val(cod);
        estudianteSeleccionado = cod;

        $('#infoEstudiante').html(
            '<div style="display: flex; justify-content: space-between; align-items: center;">' +
            '  <div>' +
            '    <p style="margin: 0 0 5px; font-size: 15px; font-weight: 700; color: #333;">' + escapeHtml(nombre) + '</p>' +
            '    <p style="margin: 0 0 3px; font-size: 13px; color: #555;"><strong>Registro:</strong> ' + (registro || '-') + '</p>' +
            '    <p style="margin: 0 0 3px; font-size: 13px; color: #555;"><strong>CUI:</strong> ' + (cui || '-') + '</p>' +
            '    <p style="margin: 0 0 3px; font-size: 13px; color: #555;"><strong>Carrera:</strong> ' + escapeHtml(carrera) + '</p>' +
            '    <p style="margin: 0; font-size: 13px; color: #555;"><strong>Correo:</strong> ' + escapeHtml(correo || '-') + '</p>' +
            '  </div>' +
            '  <div>' +
            '    <button type="button" class="btn btn-sm btn-default" id="btnCambiarEstudiante" title="Cambiar estudiante">' +
            '      <i class="fa fa-exchange"></i> Cambiar' +
            '    </button>' +
            '  </div>' +
            '</div>'
        );

        // Mostrar formulario
        $('#seccionFormulario').slideDown(300);
    });

    // ── Cambiar estudiante ─────────────────────────────────────
    $(document).on('click', '#btnCambiarEstudiante', function() {
        estudianteSeleccionado = null;
        $('#codUsuarioSeleccionado').val('');
        $('#seccionFormulario').slideUp(200);
        $('#tablaResultados tr').removeClass('seleccionado');
        $('#inputBusqueda').focus();
    });

    // ── Confirmar envío ────────────────────────────────────────
    $('#formIniciarProceso').on('submit', function(e) {
        if (!estudianteSeleccionado) {
            e.preventDefault();
            ToastService.warning('Debe seleccionar un estudiante.');
            return false;
        }

        var tipo = $('#selectTipoExamen').val();
        if (!tipo) {
            e.preventDefault();
            ToastService.warning('Debe seleccionar un tipo de examen.');
            return false;
        }

        e.preventDefault();
        ConfirmService.confirm('¿Confirma que desea iniciar el proceso de graduación para este estudiante?', function() {
            $('#loaderAsignarProceso').css('display', 'flex');
            $('#formIniciarProceso').off('submit').submit();
        });
    });

    // ── Utilidad ───────────────────────────────────────────────
    function escapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(text));
        return div.innerHTML;
    }
});
</script>
