<script>
$(document).ready(function() {
    // Extraer cod_tipo_examen desde la URL: /examen/papeleria/{cod_tipo_examen}
    var urlParts      = window.location.pathname.split('/');
    var codTipoExamen = urlParts[urlParts.length - 1];

    // Abrir modal para crear requisito
    $('#btnCrearRequisito').on('click', function() {
        $('#formRequisito')[0].reset();
        $('#idRequisito').val('');
        // Asegurar que el campo siempre lleve el código de la URL
        $('input[name="cod_tipo_examen"]').val(codTipoExamen);
        $('#modalCrearRequisitoLabel').text('Crear Requisito');
        $('#modalCrearRequisito').modal('show');
    });

    // Guardar nuevo requisito o actualizar
    $('#btnGuardarRequisito').on('click', function() {
        var form = $('#formRequisito');
        if (form[0].checkValidity()) {
            // Garantizar que el cod_tipo_examen de la URL siempre se envíe
            $('input[name="cod_tipo_examen"]').val(codTipoExamen);
            var formData = form.serialize();
            $.post('<?= $this->url('examen', ['action' => 'guardarRequisito']) ?>', formData, function(response) {
                if (response.status === 'success') {
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            }, 'json');
        } else {
            form[0].reportValidity();
        }
    });

    // Editar requisito
    $(document).on('click', '.btn-editar-accion', function() {
        var id = $(this).data('id');
        var nombre = $(this).data('nombre');
        var descripcion = $(this).data('descripcion');
        
        $('#idRequisito').val(id);
        $('#titulo').val(nombre);
        $('#descripcion').val(descripcion);
        
        $('#modalCrearRequisitoLabel').text('Editar Requisito');
        $('#modalCrearRequisito').modal('show');
    });

    // Eliminar requisito
    $(document).on('click', '.btn-eliminar-accion', function() {
        var id = $(this).data('id');
        if (confirm('¿Está seguro de que desea eliminar este requisito?')) {
            $.post('<?= $this->url('examen', ['action' => 'eliminarRequisito']) ?>', {id: id}, function(response) {
                if (response.status === 'success') {
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            }, 'json');
        }
    });
});
</script>
