<script>
$(document).ready(function() {
    // Abrir modal para crear requisito
    $('#btnCrearRequisito').on('click', function() {
        $('#formRequisito')[0].reset();
        $('#modalCrearRequisito').modal('show');
    });

    // Guardar nuevo requisito
    $('#btnGuardarRequisito').on('click', function() {
        if ($('#formRequisito')[0].checkValidity()) {
            // Aquí iría la llamada AJAX para guardar
            $('#modalCrearRequisito').modal('hide');
            $('#formRequisito')[0].reset();
        } else {
            $('#formRequisito')[0].reportValidity();
        }
    });

    // Editar requisito
    $(document).on('click', '.btn-editar-accion', function() {
        var titulo = $(this).closest('tr').find('td:eq(0)').text();
        var descripcion = $(this).closest('tr').find('td:eq(1)').text();
        $('#tituloEditar').val(titulo);
        $('#descripcionEditar').val(descripcion);
        $('#modalEditarRequisito').modal('show');
    });

    // Actualizar requisito
    $('#btnActualizarRequisito').on('click', function() {
        if ($('#formEditarRequisito')[0].checkValidity()) {
            // Aquí iría la llamada AJAX para actualizar
            $('#modalEditarRequisito').modal('hide');
        } else {
            $('#formEditarRequisito')[0].reportValidity();
        }
    });

    // Eliminar requisito
    $(document).on('click', '.btn-eliminar-accion', function() {
        if (confirm('¿Está seguro de que desea eliminar este requisito?')) {
            $(this).closest('tr').remove();
            // Aquí iría la llamada AJAX para eliminar del servidor
        }
    });
});
</script>
