<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>
<script>
$(document).ready(function() {
    // Extraer cod_tipo_examen desde la URL: /examen/papeleria/{cod_tipo_examen}
    var urlParts      = window.location.pathname.split('/');
    var codTipoExamen = urlParts[urlParts.length - 1];

    // Abrir modal para crear requisito
    $('#btnCrearRequisito').on('click', function() {
        $('#formRequisito')[0].reset();
        $('#idRequisito').val('');
        // Asegurar que el campo siempre lleve el código de la URL
        $('input[name="cod_tipo_examen"]').val(codTipoExamen);
        $('#modalCrearRequisitoLabel').text('Crear Requisito');
        $('#modalCrearRequisito').modal('show');
    });

    // Guardar nuevo requisito o actualizar (con archivo de apoyo)
    $('#btnGuardarRequisito').on('click', function() {
        var form = $('#formRequisito');
        var btn = $(this);
        
        if (form[0].checkValidity()) {
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
            
            $('input[name="cod_tipo_examen"]').val(codTipoExamen);
            
            var formData = new FormData(form[0]);
            
            $.ajax({
                url: '<?= $this->url('examen', ['action' => 'guardarRequisito']) ?>',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'success') {
                        location.reload();
                    } else {
                        ToastService.error('Error: ' + response.message);
                        btn.prop('disabled', false).html('Guardar');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', status, error);
                    console.error('Response Text:', xhr.responseText);
                    var msg = 'Error de comunicación con el servidor.';
                    if (xhr.responseText && xhr.responseText.indexOf('<') !== 0) {
                        try {
                            var resp = JSON.parse(xhr.responseText);
                            if (resp.message) msg = resp.message;
                        } catch(e) {}
                    }
                    ToastService.error(msg + ' (Status: ' + xhr.status + ')');
                    btn.prop('disabled', false).html('Guardar');
                }
            });
        } else {
            form[0].reportValidity();
        }
    });

    // Editar requisito
    $(document).on('click', '.btn-editar-accion', function() {
        var id = $(this).data('id');
        var nombre = $(this).data('nombre');
        var descripcion = $(this).data('descripcion');
        var archivo = $(this).data('archivo') || '';
        
        $('#idRequisito').val(id);
        $('#titulo').val(nombre);
        $('#descripcion').val(descripcion);
        $('#archivo_apoyo').val('');
        
        if (archivo) {
            var nombreArchivo = archivo.split('/').pop();
            $('#archivoActualLink').attr('href', '<?= $this->url('examen', ['action' => 'descargar-requisito-apoyo']) ?>?file=' + encodeURIComponent(nombreArchivo)).text(nombreArchivo);
            $('#archivoActualContainer').show();
        } else {
            $('#archivoActualContainer').hide();
        }
        
        $('#modalCrearRequisitoLabel').text('Editar Requisito');
        $('#modalCrearRequisito').modal('show');
    });

    // Eliminar requisito
    $(document).on('click', '.btn-eliminar-accion', function() {
        var id = $(this).data('id');
        ConfirmService.confirm('¿Está seguro de que desea eliminar este requisito?', function() {
            $.post('<?= $this->url('examen', ['action' => 'eliminarRequisito']) ?>', {id: id}, function(response) {
                if (response.status === 'success') {
                    location.reload();
                } else {
                    ToastService.error('Error: ' + response.message);
                }
            }, 'json');
        });
    });

    // Guardar instrucciones generales de entrega física
    $('#btnGuardarInstrucciones').on('click', function() {
        var btn = $(this);
        var instrucciones = $('#instruccionesEntregaFisica').val();
        
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
        
        $.post('<?= $this->url('examen', ['action' => 'guardarInstrucciones']) ?>', {
            cod_tipo_examen: codTipoExamen,
            instrucciones: instrucciones
        }, function(response) {
            if (response.status === 'success') {
                ToastService.success('Instrucciones guardadas correctamente');
            } else {
                alert('Error: ' + response.message);
            }
        }, 'json')
        .always(function() {
            btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar instrucciones');
        });
    });
});
</script>
