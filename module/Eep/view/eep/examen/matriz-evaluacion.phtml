<script>
$(function() {
    // Guardar tema de tesis
    $('#btnGuardarTema').on('click', function() {
        var tema = $('#temaTesis').val().trim();
        $.ajax({
            url: '<?= $urlGuardar ?>',
            type: 'POST',
            data: {
                cod_proceso: <?= $codProceso ?>,
                guardar_tema: 1,
                tema_tesis: tema
            },
            success: function(res) {
                if (res.status === 'success') {
                    alert(res.message);
                } else {
                    alert('Error: ' + res.message);
                }
            },
            error: function() {
                alert('Error de comunicación con el servidor.');
            }
        });
    });

    // Guardar matriz de evaluación
    $('.form-matriz').on('submit', function(e) {
        e.preventDefault();
        var $form = $(this);
        var posicion = $form.data('posicion');

        var respuestas = [];
        $form.find('input[name^="respuestas["]').each(function() {
            var name = $(this).attr('name');
            var match = name.match(/respuestas\[(\d+)\]\[(\w+)\]/);
            if (match) {
                var codPregunta = match[1];
                var campo = match[2];
                var val = $(this).val();

                var existing = respuestas.find(function(r) { return r.cod_pregunta == codPregunta; });
                if (!existing) {
                    existing = { cod_pregunta: codPregunta, tipo_campo: 'numero' };
                    respuestas.push(existing);
                }
                if (campo === 'tipo_campo') {
                    existing.tipo_campo = val;
                } else if (campo === 'punteo') {
                    existing.punteo = val;
                } else if (campo === 'respuesta_texto') {
                    existing.respuesta_texto = val;
                }
            }
        });

        // Capturar textareas también
        $form.find('textarea[name^="respuestas["]').each(function() {
            var name = $(this).attr('name');
            var match = name.match(/respuestas\[(\d+)\]\[(\w+)\]/);
            if (match) {
                var codPregunta = match[1];
                var campo = match[2];
                var val = $(this).val();
                var existing = respuestas.find(function(r) { return r.cod_pregunta == codPregunta; });
                if (!existing) {
                    existing = { cod_pregunta: codPregunta, tipo_campo: 'texto' };
                    respuestas.push(existing);
                }
                if (campo === 'respuesta_texto') {
                    existing.respuesta_texto = val;
                }
            }
        });

        $.ajax({
            url: '<?= $urlGuardar ?>',
            type: 'POST',
            data: {
                cod_proceso: <?= $codProceso ?>,
                posicion_examinador: posicion,
                observaciones_generales: $form.find('textarea[name="observaciones_generales"]').val(),
                respuestas: respuestas
            },
            success: function(res) {
                if (res.status === 'success') {
                    alert(res.message);
                    // Recargar para actualizar badge
                    window.location.reload();
                } else {
                    alert('Error: ' + res.message);
                }
            },
            error: function() {
                alert('Error de comunicación con el servidor.');
            }
        });
    });
});
</script>

