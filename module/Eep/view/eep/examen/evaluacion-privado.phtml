<script>
function filtrarTabla() {
    var textoBusqueda = $('#filtroBusqueda').val().toLowerCase().trim();
    var valorEstado = $('#filtroEstado').val();
    var valorFecha = $('#filtroFecha').val();
    var hayFiltro = textoBusqueda !== '' || valorEstado !== '' || valorFecha !== '';
    var filasVisibles = 0;

    $('#tablaEvaluacion tbody tr').each(function() {
        // Ignorar la fila de "No hay procesos"
        if ($(this).find('td').length === 1) return;

        var registro = $(this).find('td:eq(0)').text().toLowerCase();
        var nombre = $(this).find('td:eq(1)').text().toLowerCase();
        var estado = $(this).find('td:eq(4) span.label').text().trim();
        var fechaFila = $(this).data('fecha');

        var coincideBusqueda = textoBusqueda === '' ||
            registro.indexOf(textoBusqueda) !== -1 ||
            nombre.indexOf(textoBusqueda) !== -1;
        var coincideEstado = valorEstado === '' || estado === valorEstado;
        var coincideFecha = valorFecha === '' || fechaFila === valorFecha;

        if (coincideBusqueda && coincideEstado && coincideFecha) {
            $(this).show();
            filasVisibles++;
        } else {
            $(this).hide();
        }
    });

    // Mostrar/ocultar mensaje de "no hay resultados"
    var $tbody = $('#tablaEvaluacion tbody');
    var $noResultados = $tbody.find('.no-resultados-filtro');
    if (hayFiltro && filasVisibles === 0) {
        if ($noResultados.length === 0) {
            $tbody.append('<tr class="no-resultados-filtro"><td colspan="9" class="text-center" style="padding: 20px; color: #999;"><i class="fa fa-search"></i> No se encontraron resultados con los filtros aplicados.</td></tr>');
        }
    } else {
        $noResultados.remove();
    }
}

function limpiarFiltros() {
    $('#filtroBusqueda').val('');
    $('#filtroEstado').val('');
    $('#filtroFecha').val('');
    $('#tablaEvaluacion tbody tr').show();
    $('#tablaEvaluacion tbody .no-resultados-filtro').remove();
}
</script>

