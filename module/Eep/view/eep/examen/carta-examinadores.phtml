                                        default:            $labelClass = 'default'; break;
                                    }
                                    ?>
                                    <span class="label label-<?= $labelClass ?>">
                                        <?= $this->escapeHtml(strtoupper($estadoPaso ?: 'pendiente')) ?>
                                    </span>
                                </td>
                                <td style="text-align:center;">
                                    <a class="btn btn-xs btn-primary"
                                       href="<?= $this->url('examen', ['action' => 'ver-carta', 'id' => $p['cod_proceso']]) ?>">
