                        <li class="<?= $pg === $paginacion['pagina'] ? 'active' : '' ?>">
                            <a href="<?= $this->url('examen', ['action' => 'carta-examinadores']) ?>?page=<?= $pg ?>">
                                <?= $pg ?>
                            </a>
                        </li>
                        <?php endfor; ?>
                    </ul>
                </nav>
