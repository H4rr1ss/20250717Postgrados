                            <tr>
                                <th style="width:5%;">#</th>
                                <th>Estudiante</th>
                                <th style="width:14%;">Carné</th>
                                <th style="width:18%;">Tipo de Examen</th>
                                <th style="width:13%;">Fecha Solicitud</th>
                                <th style="width:14%;">Estado Ciclo</th>
                                <th style="width:10%; text-align:center;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($procesos as $i => $p): ?>
                            <tr>
                                <td><?= $i + 1 ?></td>
                                <td><?= $this->escapeHtml(($p['nombres'] ?? '') . ' ' . ($p['apellidos'] ?? '')) ?></td>
