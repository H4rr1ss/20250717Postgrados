                                <td><?= $this->escapeHtml($p['tipo_examen'] ?? '-') ?></td>
                                <td>
                                    <?= !empty($p['fecha_solicitud'])
                                        ? date('d/m/Y', strtotime($p['fecha_solicitud']))
                                        : '-' ?>
                                </td>
                                <td>
                                    <?php
                                    $estadoPaso = $p['estado_paso'] ?? '';
                                    switch ($estadoPaso) {
