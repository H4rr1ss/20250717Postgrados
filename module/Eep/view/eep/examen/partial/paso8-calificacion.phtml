                            <thead style="background: #f5f5f5;">
                                <tr>
                                    <th>Miembro</th>
                                    <th>Voto</th>
                                    <th>Nota</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Dr. Roberto Martínez</td>
                                    <td>
                                        <select class="form-control input-sm">
                                            <option value="">-</option>
                                            <option value="a">Aprobado</option>
                                            <option value="r">Reprobado</option>
                                        </select>
                                    </td>
                                    <td><input type="number" class="form-control input-sm" min="0" max="100"></td>
                                </tr>
                                <tr>
                                    <td>Dra. María González</td>
                                    <td>
                                        <select class="form-control input-sm">
                                            <option value="">-</option>
                                            <option value="a">Aprobado</option>
                                            <option value="r">Reprobado</option>
                                        </select>
                                    </td>
                                    <td><input type="number" class="form-control input-sm" min="0" max="100"></td>
                                </tr>
                                <tr>
                                    <td>Dr. Juan Carlos Pérez</td>
                                    <td>
                                        <select class="form-control input-sm">
                                            <option value="">-</option>
                                            <option value="a">Aprobado</option>
                                            <option value="r">Reprobado</option>
                                        </select>
                                    </td>
                                    <td><input type="number" class="form-control input-sm" min="0" max="100"></td>
                                </tr>
                            </tbody>
                            <tfoot style="background: #f8f9fa;">
                                <tr>
                                    <td><strong>Promedio</strong></td>
                                    <td>-</td>
                                    <td><strong id="promedioNotas">-</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Observaciones y recomendaciones -->
                <div class="row" style="margin-top: 25px;">
                    <div class="col-md-12">
                        <h5 style="font-weight: 600; margin-bottom: 15px;">Observaciones y Recomendaciones</h5>
                        <textarea class="form-control" rows="4" placeholder="Registrar observaciones del tribunal, recomendaciones de modificaciones (si aplica), etc."></textarea>
                    </div>
                </div>

                <!-- Firmas -->
                <div class="row" style="margin-top: 25px;">
                    <div class="col-md-12">
                        <h5 style="font-weight: 600; margin-bottom: 15px;">Confirmación de Firmas</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <label class="checkbox-inline">
                                    <input type="checkbox"> Dr. Roberto Martínez (Presidente)
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="checkbox-inline">
                                    <input type="checkbox"> Dra. María González (Secretario)
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="checkbox-inline">
                                    <input type="checkbox"> Dr. Juan Carlos Pérez (Asesor)
