<!-- Paso 9: Calificación -->
<div class="row" style="margin-top: 20px;">
    <div class="col-lg-12">
        <div class="panel-revision">
            <div class="panel-revision-heading">
                Registro de Calificación
            </div>
            <div class="panel-revision-body" style="padding: 20px;">
                
                <!-- Resultado del examen -->
                <div class="row">
                    <div class="col-md-6">
                        <h5 style="font-weight: 600; margin-bottom: 15px;">Resultado del Examen</h5>
                        <div class="form-group">
                            <label>Calificación General</label>
                            <select class="form-control" id="resultadoExamen" style="font-size: 16px;">
                                <option value="">Seleccione el resultado...</option>
                                <option value="aprobado">APROBADO</option>
                                <option value="aprobado_modificaciones">APROBADO CON MODIFICACIONES</option>
