<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>
<script>
$(document).ready(function () {
    // ── Validar ubicación obligatoria ──────────────────────────
    function obtenerUbicacion() {
        var val = $('#ubicacionExamen').val().trim();
        return val;
    }

    function validarUbicacion() {
        var u = obtenerUbicacion();
        if (!u) {
            ToastService.warning('Debe ingresar la ubicación del examen antes de continuar.');
            $('#ubicacionExamen').focus();
            return false;
        }
        return true;
    }

    // ── Vista previa del correo ──────────────────────────────
    $('#btnVistaPrevia').on('click', function () {
        var codProceso = $('#btnNotificarEstudiante').data('cod-proceso');
        if (!codProceso) return;
        if (!validarUbicacion()) return;

        var infoExtra = $('#infoExtra').val();
        var ubicacion = obtenerUbicacion();
        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Cargando...');

        $.ajax({
            url: '/examen/preview-notificacion',
            method: 'POST',
            data: {
                cod_proceso: codProceso,
                info_extra: infoExtra,
                ubicacion: ubicacion
            },
            dataType: 'json',
            success: function (resp) {
                if (resp.success && resp.html) {
                    $('#previewAsunto').text(resp.asunto || '');
                    $('#previewCuerpo').html(resp.html);
                    $('#modalVistaPrevia').modal('show');
                } else {
                    ToastService.error(resp.message || 'No se pudo generar la vista previa.');
                }
            },
            error: function () {
                ToastService.error('Error de conexión al obtener la vista previa.');
            },
            complete: function () {
                btn.prop('disabled', false).html('<i class="fa fa-eye"></i> Vista previa del correo');
            }
        });
    });

    // ── Notificar estudiante ─────────────────────────────────
    $('#btnNotificarEstudiante').on('click', function () {
        var codProceso = $(this).data('cod-proceso');
        if (!codProceso) return;
        if (!validarUbicacion()) return;

        var btn = $(this);
        ConfirmService.confirm('¿Confirma que desea notificar al estudiante sobre su examen de graduación?', function() {
            var infoExtra = $('#infoExtra').val();
            var ubicacion = obtenerUbicacion();
        
        // Mostrar loader mientras se procesa
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando notificación...');

        $.ajax({
            url: '/examen/notificar-estudiante',
            method: 'POST',
            data: {
                cod_proceso: codProceso,
                info_extra: infoExtra,
                ubicacion: ubicacion
            },
            dataType: 'json',
            success: function (resp) {
                console.log('Respuesta del servidor:', resp);
                if (resp.success) {
                    ToastService.success('Estudiante notificado correctamente.');
                    window.location.href = '/examen';
                } else {
                    ToastService.error(resp.message || 'Error al notificar al estudiante.');
                }
            },
            error: function () {
                ToastService.error('Error de conexión. Inténtelo de nuevo.');
            },
            complete: function () {
                // Restaurar el botón solo si no se redirigió exitosamente
                btn.prop('disabled', false).html('<i class="fa fa-envelope"></i> Notificar Estudiante');
            }
        });
        });
    });
});
</script>
