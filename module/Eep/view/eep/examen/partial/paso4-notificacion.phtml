<script>
$(document).ready(function () {
    $('#btnNotificarEstudiante').on('click', function () {
        var codProceso = $(this).data('cod-proceso');
        if (!codProceso) return;

        if (!confirm('¿Confirma que desea notificar al estudiante sobre su examen de graduación?')) return;

        $.ajax({
            url: '/examen/notificar-estudiante',
            method: 'POST',
            data: {
                cod_proceso: codProceso
            },
            dataType: 'json',
            success: function (resp) {
                console.log('Respuesta del servidor:', resp);
                if (resp.success) {
                    alert('Estudiante notificado correctamente.');
                    window.location.href = '/examen';
                } else {
                    alert(resp.message || 'Error al notificar al estudiante.');
                }
            },
            error: function () {
                alert('Error de conexión. Inténtelo de nuevo.');
            }
        });
    });
});
</script>
