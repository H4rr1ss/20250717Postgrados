<script>
$(document).ready(function() {
    let filaActual = null;
    let botonActual = null;

    // ── Acciones de revisión en la tabla ───────────────────────────────────────
    $('.btn-accion').on('click', function() {
        const boton = $(this);
        const grupo = boton.parent();
        const estadoSeleccionado = boton.data('valor');
        const fila  = boton.closest('tr');

        if (boton.hasClass('active')) {
            aplicarEstadoPendiente(fila, grupo);
            return;
        }

        if (estadoSeleccionado === 'aprobado') {
            aplicarEstadoAceptado(fila, boton, grupo);
        } else if (estadoSeleccionado === 'rechazado') {
            filaActual  = fila;
            botonActual = boton;
            $('#nombreRequisito').text(fila.find('td:first').text());
            $('#razonRechazo').val(fila.find('td').eq(3).text());
            $('#modalRazonRechazo').modal('show');
        }
    });

    $('#confirmarRechazo').on('click', function() {
        const razonRechazo = $('#razonRechazo').val().trim();
        if (razonRechazo === '') {
            alert('Por favor, ingrese una razón para el rechazo.');
            return;
        }
        aplicarEstadoRechazado(filaActual, botonActual, razonRechazo);
        $('#modalRazonRechazo').modal('hide');
    });

    // ── Funciones de estado ────────────────────────────────────────────────────
    function aplicarEstadoAceptado(fila, boton, grupo) {
        fila.removeClass('fila-rechazada fila-pendiente').addClass('fila-aceptada');
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        fila.find('td').eq(3).text('');
        fila.find('.estado-badge')
            .removeClass('estado-rechazado estado-pendiente')
            .addClass('estado-aceptado').text('Aprobado');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function aplicarEstadoRechazado(fila, boton, razonRechazo) {
        const grupo = boton.parent();
        fila.removeClass('fila-aceptada fila-pendiente').addClass('fila-rechazada');
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        fila.find('td').eq(3).text(razonRechazo);
        fila.find('.estado-badge')
            .removeClass('estado-aceptado estado-pendiente')
            .addClass('estado-rechazado').text('Rechazado');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function aplicarEstadoPendiente(fila, grupo) {
        fila.removeClass('fila-aceptada fila-rechazada').addClass('fila-pendiente');
        grupo.find('.btn-accion').removeClass('active');
        fila.find('td').eq(3).text('');
        fila.find('.estado-badge')
            .removeClass('estado-aceptado estado-rechazado')
            .addClass('estado-pendiente').text('Pendiente');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function mostrarAlertaGuardar() {
        $('#alertaRecordatorioGuardar').fadeIn(400);
    }

    // ── Estado de avance (todos aprobados?) ────────────────────────────────────
    function actualizarEstadoAvance() {
        const filas     = $('.table-requisitos tbody tr[data-cod-requisito]');
        const total     = filas.length;
        const aceptados = filas.filter('.fila-aceptada').length;
        const todosAceptados = total > 0 && total === aceptados;

        const pasoActual = <?= (int)$this->paso ?>;
        $('.timeline-link').each(function() {
            const pasoLink = parseInt($(this).attr('href').split('paso=')[1]) || 0;
            if (pasoLink > pasoActual) {
                if (!todosAceptados) {
                    $(this).css({ 'opacity': '0.5', 'pointer-events': 'none' });
                } else {
                    $(this).css({ 'opacity': '1', 'pointer-events': '' });
                }
            }
        });

        return todosAceptados;
    }

    // ── Inicializar colores al cargar ──────────────────────────────────────────
    $('.table-requisitos tbody tr[data-cod-requisito]').each(function() {
        const estado = $(this).find('.estado-badge').text().trim().toLowerCase();
        if (estado === 'aprobado') {
            $(this).addClass('fila-aceptada');
        } else if (estado === 'rechazado') {
            $(this).addClass('fila-rechazada');
        } else {
            $(this).addClass('fila-pendiente');
        }
    });
    setTimeout(actualizarEstadoAvance, 300);

    // ── Guardar cambios (AJAX) ─────────────────────────────────────────────────
    $('#btnGuardarCambios').on('click', function() {
        const btn          = $(this);
        const originalText = btn.text();
        const requisitos   = [];

        $('.table-requisitos tbody tr[data-cod-requisito]').each(function() {
            const fila      = $(this);
            const activo    = fila.find('.btn-accion.active');
            const estado    = activo.length ? activo.data('valor') : 'pendiente';
            requisitos.push({
                cod_requisito:    fila.data('cod-requisito'),
                cod_documento:    fila.data('cod-documento') || null,
                estado_evaluacion: estado,
                observacion:      fila.find('td').eq(3).text().trim()
            });
        });

        btn.prop('disabled', true).text('Guardando...');

        $.ajax({
            url:      '<?= $this->url("examen", ["action" => "guardarRevision"]) ?>',
            type:     'POST',
            dataType: 'json',
            data: {
                cod_proceso:    '<?= $this->proceso["cod_proceso"] ?>',
                cod_paso_actual:'<?= $this->proceso["cod_paso_actual"] ?>',
                requisitos:     requisitos
            },
            success: function(response) {
                if (response.success) {
                    if (response.avanzado) {
                        // Todos aprobados → paso avanzado
                        alert(response.message);
                        location.reload();
                    } else {
                        // Hay rechazados: guardado pero sin avance
                        alert(response.message);
                        $('#alertaRecordatorioGuardar').fadeOut(300);
                        btn.prop('disabled', false).text(originalText);
                    }
                } else {
                    alert('Error: ' + (response.message || 'No se pudieron guardar los cambios.'));
                    btn.prop('disabled', false).text(originalText);
                }
            },
            error: function() {
                alert('Error de comunicación con el servidor.');
                btn.prop('disabled', false).text(originalText);
            }
        });
    });
});
</script>
