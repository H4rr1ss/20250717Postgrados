<script>
$(document).ready(function() {
    let filaActual = null;
    let botonActual = null;

    // Manejar click en ver documento
    $('.btn-ver-documento').on('click', function() {
        alert('Función para ver documento');
    });

        // Manejar click en botones de acción
    $('.btn-accion').on('click', function() {
        const boton = $(this);
        const grupo = boton.parent();
        const estadoSeleccionado = boton.data('valor'); 
        const fila = boton.closest('tr');
        const nombreRequisito = fila.find('td:first').text();
        const yaEstaActivo = boton.hasClass('active');
        
        if (yaEstaActivo) {
            aplicarEstadoPendiente(fila, grupo);
            return;
        }
        
        if (estadoSeleccionado === 'aprobado') { 
            aplicarEstadoAceptado(fila, boton, grupo);
        } else if (estadoSeleccionado === 'rechazado') {
            filaActual = fila;
            botonActual = boton;
            
            $('#nombreRequisito').text(nombreRequisito);
            const obsActual = fila.find('.observacion-doc').val();
            $('#razonRechazo').val(obsActual);
            $('#modalRazonRechazo').modal('show');
        }
    });

    $('#confirmarRechazo').on('click', function() {
        const razonRechazo = $('#razonRechazo').val().trim();
        if (razonRechazo === '') {
            alert('Por favor, ingrese una razón para el rechazo.');
            return;
        }
        aplicarEstadoRechazado(filaActual, botonActual, razonRechazo);
        $('#modalRazonRechazo').modal('hide');
    });

    function aplicarEstadoAceptado(fila, boton, grupo) {
        fila.removeClass('fila-rechazada fila-pendiente').addClass('fila-aceptada');
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        fila.find('.observacion-doc').val('');
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-rechazado estado-pendiente').addClass('estado-aceptado').text('Aprobado');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function aplicarEstadoRechazado(fila, boton, razonRechazo) {
        const grupo = boton.parent();
        fila.removeClass('fila-aceptada fila-pendiente').addClass('fila-rechazada');
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        fila.find('.observacion-doc').val(razonRechazo);
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-aceptado estado-pendiente').addClass('estado-rechazado').text('Rechazado');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function aplicarEstadoPendiente(fila, grupo) {
        fila.removeClass('fila-aceptada fila-rechazada').addClass('fila-pendiente');
        grupo.find('.btn-accion').removeClass('active');
        fila.find('.observacion-doc').val('');
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-aceptado estado-rechazado').addClass('estado-pendiente').text('Pendiente');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function mostrarAlertaGuardar() {
        $('#alertaRecordatorioGuardar').fadeIn(400);
    }

    function actualizarEstadoAvance() {
        const filas = $('.table-requisitos tbody tr');
        const totalRequisitos = filas.length;
        const requisitosAceptados = filas.filter('.fila-aceptada').length;
        const todosAceptados = totalRequisitos > 0 && totalRequisitos === requisitosAceptados;
        return todosAceptados;
    }

    $('.table-requisitos tbody tr').each(function() {
        const estadoTxt = $(this).find('.estado-badge').text().trim().toLowerCase();
        if (estadoTxt === 'aprobado' || estadoTxt === 'aceptado') {
            $(this).addClass('fila-aceptada');
        } else if (estadoTxt === 'rechazado') {
            $(this).addClass('fila-rechazada');
        } else {
            $(this).addClass('fila-pendiente');
        }
    });
    
    setTimeout(actualizarEstadoAvance, 500);

    $('#btnGuardarCambios').on('click', function() {
        if ($(this).hasClass('disabled')) return;
        const btn = $(this);
        const originalText = btn.text();
        const requisitos = [];
        $('.table-requisitos tbody tr[data-id-requisito]').each(function() {
            const fila = $(this);
            const idReq = fila.data('id-requisito');
            const botonActivo = fila.find('.btn-accion.active');
            const observacion = fila.find('.observacion-doc').val();
            let estado = 'pendiente';
            if (botonActivo.length > 0) {
                estado = botonActivo.data('valor');
            }
            requisitos.push({
                id_requisito: idReq,
                estado_evaluacion: estado,
                observacion: observacion
            });
        });

        btn.prop('disabled', true).text('Guardando...');
        $.ajax({
            url: '<?= $this->url("examen", ["action" => "guardarRevision"]) ?>',
            type: 'POST',
            data: {
                cod_proceso: '<?= $this->proceso["cod_proceso"] ?>',
                id_paso: '1',
                requisitos: requisitos
            },
            success: function(response) {
                if (response.success) {
                    alert('Cambios guardados exitosamente.');
                    $('#alertaRecordatorioGuardar').fadeOut(300);
                    location.reload();
                } else {
                    alert('Error: ' + (response.message || 'No se pudieron guardar los cambios.'));
                    btn.prop('disabled', false).text(originalText);
                }
            },
            error: function() {
                alert('Error de comunicación con el servidor.');
                btn.prop('disabled', false).text(originalText);
            }
        });
    });


    function aplicarEstadoAceptado(fila, boton, grupo) {
        // Remover clases de estado
        fila.removeClass('fila-rechazada fila-pendiente').addClass('fila-aceptada');
        
        // Actualizar botones
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        
        // Limpiar razón de rechazo
        fila.find('td').eq(3).text('');
        
        // Actualizar estado visual
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-rechazado estado-pendiente').addClass('estado-aceptado').text('Aceptado');
        
        console.log('Requisito aceptado');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function aplicarEstadoRechazado(fila, boton, razonRechazo) {
        const grupo = boton.parent();
        
        // Remover clases de estado
        fila.removeClass('fila-aceptada fila-pendiente').addClass('fila-rechazada');
        
        // Actualizar botones
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        
        // Actualizar razón de rechazo
        fila.find('td').eq(3).text(razonRechazo);
        
        // Actualizar estado visual
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-aceptado estado-pendiente').addClass('estado-rechazado').text('Rechazado');
        
        console.log('Requisito rechazado:', razonRechazo);
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function aplicarEstadoPendiente(fila, grupo) {
        // Remover clases de estado
        fila.removeClass('fila-aceptada fila-rechazada').addClass('fila-pendiente');
        
        // Desactivar todos los botones
        grupo.find('.btn-accion').removeClass('active');
        
        // Limpiar razón de rechazo
        fila.find('td').eq(3).text('');
        
        // Actualizar estado visual
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-aceptado estado-rechazado').addClass('estado-pendiente').text('Pendiente');
        
        console.log('Requisito pendiente');
        actualizarEstadoAvance();
        mostrarAlertaGuardar();
    }

    function mostrarAlertaGuardar() {
        $('#alertaGuardarCambios').fadeIn(400);
        $('#alertaRecordatorioGuardar').fadeIn(400);
    }

    function actualizarEstadoAvance() {
        // Obtenemos solo las filas que son de requisitos 
        const filas = $('.table-requisitos tbody tr');
        const totalRequisitos = filas.length;
        const requisitosAceptados = filas.filter('.fila-aceptada').length;
        const todosAceptados = totalRequisitos === requisitosAceptados;
        
        console.log(`Avance: ${requisitosAceptados}/${totalRequisitos}`);
        
        // Desactivar/Activar visualmente los pasos siguientes en el timeline
        // Usamos el paso desde el objeto PHP
        const pasoActual = <?= $this->paso ?>;
        $('.timeline-link').each(function() {
            const pasoLink = $(this).data('paso');
            if (pasoLink > pasoActual) {
                if (!todosAceptados) {
                    $(this).addClass('link-desactivado').css({
                        'opacity': '0.5',
                        'cursor': 'not-allowed'
                    });
                } else {
                    $(this).removeClass('link-desactivado').css({
                        'opacity': '1',
                        'cursor': 'pointer'
                    });
                }
            }
        });
        
        return todosAceptados;
    }

    // Inicializar estado al cargar
    $('.table-requisitos tbody tr').each(function() {
        const estadoTxt = $(this).find('.estado-badge').text().trim().toLowerCase();
        if (estadoTxt === 'aceptado') {
            $(this).addClass('fila-aceptada');
        } else if (estadoTxt === 'rechazado') {
            $(this).addClass('fila-rechazada');
        } else {
            $(this).addClass('fila-pendiente');
        }
    });
    
    // Ejecutar inicialización del avance
    setTimeout(actualizarEstadoAvance, 500);

    // Bloquear el click en el timeline si no se ha completado la papelería
    $(document).on('click', '.timeline-link', function(e) {
        const pasoLink = $(this).data('paso');
        const pasoActual = <?= $this->paso ?>;
        
        if (pasoLink > pasoActual) {
            if (!actualizarEstadoAvance()) {
                e.preventDefault();
                alert('Debe aceptar todos los requisitos de papelería para continuar al siguiente paso.');
                return false;
            }
        }
    });

    // Manejar click en guardar cambios
    $('#btnGuardarCambios').on('click', function() {
        // Recopilar estados de todos los requisitos
        const estados = [];
        $('.acciones-grupo').each(function() {
            const botonActivo = $(this).find('.btn-accion.active');
            const fila = $(this).closest('tr');
            const nombreRequisito = fila.find('td:first').text();
            const razonRechazo = fila.find('td').eq(3).text();
            
            let estado = 'pendiente'; // Estado por defecto
            if (botonActivo.length > 0) {
                estado = botonActivo.data('estado');
            }
            
            estados.push({
                requisito: nombreRequisito,
                estado: estado,
                razonRechazo: razonRechazo
            });
        });
        
        console.log('Estados a guardar:', estados);
        $('#alertaGuardarCambios').fadeOut(300);
        $('#alertaRecordatorioGuardar').fadeOut(300);
        alert('Guardando cambios de papelería...');
    });
});
</script>
