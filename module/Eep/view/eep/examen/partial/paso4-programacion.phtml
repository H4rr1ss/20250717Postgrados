<!-- Paso 5: Programación de Fecha -->
<div class="row" style="margin-top: 20px;">
    <div class="col-lg-12">
        <div class="panel-revision">
            <div class="panel-revision-heading">
                Programación de Fecha de Examen
            </div>
            <div class="panel-revision-body" style="padding: 20px;">
                
                <!-- Formulario de programación -->
                <div class="row">
                    <div class="col-md-6">
                        <h5 style="font-weight: 600; margin-bottom: 15px;">Datos del Examen</h5>
                        <form>
                            <div class="form-group">
                                <label>Fecha del Examen</label>
                                <input type="date" class="form-control" id="fechaExamen">
                            </div>
                            <div class="form-group">
                                <label>Hora de Inicio</label>
                                <input type="time" class="form-control" id="horaExamen" value="09:00">
                            </div>
                            <div class="form-group">
                                <label>Duración Estimada</label>
                                <select class="form-control" id="duracionExamen">
                                    <option value="60">1 hora</option>
                                    <option value="90">1 hora 30 minutos</option>
                                    <option value="120" selected>2 horas</option>
                                    <option value="180">3 horas</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Lugar</label>
                                <select class="form-control" id="lugarExamen">
                                    <option value="">Seleccione un lugar...</option>
                                    <option value="sala1">Sala de Reuniones 1 - Edificio T-3</option>
                                    <option value="sala2">Sala de Reuniones 2 - Edificio T-3</option>
                                    <option value="auditorio">Auditorio de Postgrados</option>
                                    <option value="virtual">Virtual (Teams/Zoom)</option>
                                </select>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-6">
                        <h5 style="font-weight: 600; margin-bottom: 15px;">Disponibilidad</h5>
                        <div class="alert alert-warning">
                            <i class="fa fa-calendar"></i> <strong>Próximas fechas disponibles:</strong>
                            <ul style="margin: 10px 0 0 0; padding-left: 20px;">
                                <li>Viernes 28 de febrero, 2026</li>
                                <li>Lunes 03 de marzo, 2026</li>
                                <li>Miércoles 05 de marzo, 2026</li>
                            </ul>
                        </div>
                        
                        <h5 style="font-weight: 600; margin: 20px 0 15px 0;">Calendario</h5>
                        <div style="background: #f8f9fa; padding: 15px; border-radius: 4px; text-align: center;">
                            <p style="color: #666; margin: 0;">
                                <i class="fa fa-calendar fa-3x" style="color: #ccc;"></i><br><br>
                                Calendario interactivo<br>
                                <small>(Próximamente)</small>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Acciones -->
                <div style="text-align: right; padding: 15px 0 5px 0; border-top: 1px solid #eee; margin-top: 20px;">
                    <button class="btn btn-default" style="margin-right: 10px;">
                        <i class="fa fa-calendar-check-o"></i> Verificar Disponibilidad
                    </button>
                    <button class="btn btn-primary">
                        <i class="fa fa-save"></i> Programar Fecha
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
