<script>
$(document).ready(function() {
    const COD_PROCESO = <?= $codProceso ?>;

    // ── Helpers ──────────────────────────────────────────────────
    function mostrarToast(mensaje, tipo) {
        const id  = 'toast-terna-' + Date.now();
        const html = `<div id="${id}" class="alert alert-${tipo}" role="alert"
            style="position:fixed;bottom:20px;right:20px;z-index:9999;
                   min-width:280px;box-shadow:0 4px 12px rgba(0,0,0,.15);">
            ${mensaje}</div>`;
        $('body').append(html);
        setTimeout(function() { $('#' + id).fadeOut(400, function() { $(this).remove(); }); }, 3500);
    }

    function recopilarTerna() {
        const terna = {};
        $('.examinador-card').each(function() {
            const rol      = $(this).data('rol');
            const nombre   = $(this).find('.examinador-nombre').val().trim();
            const colegiado = $(this).find('.examinador-colegiado').val().trim();
            const correo   = $(this).find('.examinador-correo').val().trim();
            terna[rol] = { nombre: nombre, colegiado: colegiado, correo: correo };
        });
        return terna;
    }

    function enviarTerna(terna, programacion, btn, labelOk) {
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
        $.ajax({
            url:  '/examen/guardarTerna',
            type: 'POST',
            data: {
                cod_proceso:  COD_PROCESO,
                terna:        terna,
                programacion: programacion
            },
            success: function(response) {
                if (response.status === 'success') {
                    mostrarToast(labelOk, 'success');
                } else {
                    mostrarToast('Error: ' + (response.message || 'No se pudo guardar.'), 'danger');
                }
            },
            error: function() {
                mostrarToast('Error de comunicación con el servidor.', 'danger');
            },
            complete: function() {
                btn.prop('disabled', false).html(btn.data('label-orig'));
            }
        });
    }

    // Guardar la etiqueta original de cada botón para restaurarla
    $('#btnGuardarCambios, #btnGuardarTerna').each(function() {
        $(this).data('label-orig', $(this).html());
    });

    // ── Guardar fecha/hora ────────────────────────────────────────
    $('#btnGuardarCambios').on('click', function() {
        const fecha = $('#fechaExamen').val();
        const hora  = $('#horaExamen').val();

        if (!fecha) { mostrarToast('Seleccione una fecha para el examen.', 'warning'); return; }
        if (!hora)  { mostrarToast('Seleccione una hora para el examen.',  'warning'); return; }

        const terna = recopilarTerna();
        enviarTerna(terna, { fecha: fecha, hora: hora }, $(this), 'Fecha y hora guardadas correctamente.');
    });

    // ── Cancelar fecha/hora ───────────────────────────────────────
    $('#btnCancelar').on('click', function() {
        if (confirm('¿Está seguro que desea cancelar los cambios de fecha?')) {
            $('#fechaExamen').val('<?= htmlspecialchars($fechaExamen) ?>');
            $('#horaExamen').val('<?= htmlspecialchars($horaExamen) ?>');
        }
    });

    // ── Guardar terna completa ────────────────────────────────────
    $('#btnGuardarTerna').on('click', function() {
        const terna = recopilarTerna();
        const fecha = $('#fechaExamen').val();
        const hora  = $('#horaExamen').val();

        // Validar que todos los roles tengan nombre y colegiado
        let camposVacios = false;
        $.each(terna, function(rol, datos) {
            if (!datos.nombre || !datos.colegiado) { camposVacios = true; }
        });

        if (camposVacios) {
            mostrarToast('Complete nombre y número de colegiado de cada examinador.', 'warning');
            return;
        }

        enviarTerna(terna, { fecha: fecha, hora: hora }, $(this), 'Terna guardada correctamente.');
    });
});
</script>
