<script>
$(document).ready(function() {
    const COD_PROCESO = <?= $codProceso ?>;

    // ── Recargar al volver de editar examinador ───────────────────
    document.addEventListener('visibilitychange', function() {
        if (document.visibilityState === 'visible' && localStorage.getItem('eeditando_examinador')) {
            localStorage.removeItem('eeditando_examinador');
            location.reload();
        }
    });
    // Marcar bandera cuando se abre el link de edición de examinador
    $(document).on('click', 'a[href*="studentSearch"]', function() {
        localStorage.setItem('eeditando_examinador', '1');
    });

    // ── Inicializar estado de cada card según tipo seleccionado ───
    $('.examinador-card').each(function() {
        const card = $(this);
        const tipo = card.find('.examinador-tipo').val();
        if (tipo === 'interno') {
            card.find('.campos-interno').show();
            card.find('.campos-externo').hide();
            card.find('.campos-externo input').prop('disabled', true);
            card.find('.campos-interno select').prop('disabled', false);
            card.find('.campos-interno input').prop('disabled', false);
        } else if (tipo === 'externo') {
            card.find('.campos-interno').hide();
            card.find('.campos-externo').show();
            card.find('.campos-interno select').prop('disabled', true);
            card.find('.campos-interno input').prop('disabled', true);
            card.find('.campos-externo input').prop('disabled', false);
        }
    });

    // ── Cambio de tipo de examinador ──────────────────────────────
    $(document).on('change', '.examinador-tipo', function() {
        const card = $(this).closest('.examinador-card');
        const tipo = $(this).val();
        
        if (tipo === 'interno') {
            card.find('.campos-interno').show();
            card.find('.campos-externo').hide();
            card.find('.campos-externo input').val('').prop('disabled', true);
            card.find('.campos-interno select').prop('disabled', false);
            card.find('.campos-interno input').prop('disabled', false);
        } else if (tipo === 'externo') {
            card.find('.campos-interno').hide();
            card.find('.campos-externo').show();
            card.find('.campos-interno input').val('').prop('disabled', true);
            card.find('.campos-interno select').prop('disabled', true);
            card.find('.campos-externo input').prop('disabled', false);
        }
    });

    // ── Cambio de docente interno ─────────────────────────────────
    $(document).on('change', '.examinador-docente', function() {
        const card = $(this).closest('.examinador-card');
        const option = $(this).find(':selected');

        const nombre = option.data('nombre') || '';
        const colegiado = option.data('colegiado') || '';
        const titulo = option.data('titulo') || '';
        const correo = option.data('correo') || '';

        // Actualizar SOLO los campos de interno (visibles)
        card.find('.campos-interno .examinador-titulo').val(titulo);
        card.find('.campos-interno .examinador-nombre').val(nombre);
        card.find('.campos-interno .examinador-colegiado').val(colegiado);
        card.find('.campos-interno .examinador-correo').val(correo);
    });

    // ── Helpers ──────────────────────────────────────────────────
    function validarExaminadoresDuplicados() {
        const colegiados = [];
        let hayDuplicados = false;
        
        $('.examinador-card').each(function() {
            const tipo = $(this).find('.examinador-tipo').val();
            if (!tipo) return true;
            const colegiado = (tipo === 'interno')
                ? $(this).find('.campos-interno .examinador-colegiado').val().trim()
                : $(this).find('.campos-externo .examinador-colegiado').val().trim();
            if (colegiado !== "") {
                colegiados.push(colegiado);
            }
        });
        
        // Verificar duplicados en números de colegiado
        const colegiadosUnicos = [...new Set(colegiados)];
        if (colegiados.length !== colegiadosUnicos.length) {
            hayDuplicados = true;
        }
        
        return hayDuplicados;
    }

    function verificarTernaCompleta() {
        const terna = recopilarTerna();
        let completa = true;
        
        // Verificar que los 3 examinadores tengan tipo, titulo, nombre, colegiado y correo
        $.each(terna, function(id, datos) {
            if (!datos.tipo_examinador || !datos.titulo || !datos.nombre || !datos.colegiado || !datos.correo) {
                completa = false;
                return false; // break del each
            }
        });
        
        return completa;
    }

    function recopilarTerna() {
        const terna = [];
        const examinadoresDB = <?= json_encode($examinadores) ?>;

        $('.examinador-card').each(function() {
            const posicion = $(this).data('id');
            const tipo      = $(this).find('.examinador-tipo').val();
            if (!tipo) return true; // skip vacíos

            const docenteSelect = $(this).find('.examinador-docente');
            const codUsuario = docenteSelect.val();
            // Leer SOLO los campos del tipo seleccionado
            const nombre   = (tipo === 'interno')
                ? $(this).find('.campos-interno .examinador-nombre').val().trim()
                : $(this).find('.campos-externo .examinador-nombre').val().trim();
            const colegiado = (tipo === 'interno')
                ? $(this).find('.campos-interno .examinador-colegiado').val().trim()
                : $(this).find('.campos-externo .examinador-colegiado').val().trim();
            const titulo = (tipo === 'interno')
                ? $(this).find('.campos-interno .examinador-titulo').val().trim()
                : $(this).find('.campos-externo .examinador-titulo').val().trim();
            const correo   = (tipo === 'interno')
                ? $(this).find('.campos-interno .examinador-correo').val().trim()
                : $(this).find('.campos-externo .examinador-correo').val().trim();
            
            // Buscar datos originales de este examinador en el array de la BD
            const original = examinadoresDB.find(ex => parseInt(ex.posicion) === parseInt(posicion)) || {};
            
            let haCambiado = false;
            let datos = {
                posicion:        posicion,
                tipo_examinador: tipo
            };
            
            if (tipo === 'interno') {
                datos.cod_usuario = codUsuario;
                datos.titulo = titulo;
                datos.colegiado = colegiado;
                haCambiado = 
                    (tipo || '') !== (original.tipo || '') ||
                    (codUsuario || '') !== (original.cod_usuario || '') ||
                    (titulo || '') !== (original.titulo || '') ||
                    (colegiado || '') !== (original.colegiado || '');
            } else {
                datos.nombre = nombre;
                datos.colegiado = colegiado;
                datos.titulo = titulo;
                datos.correo = correo;
                haCambiado = 
                    (tipo || '')      !== (original.tipo || '') ||
                    (nombre || '')    !== (original.nombre || '') ||
                    (colegiado || '') !== (original.colegiado || '') ||
                    (titulo || '')    !== (original.titulo || '') ||
                    (correo || '')    !== (original.correo || '');
            }

            // Solo agregar si ha habido cambios respecto a la base de datos
            if (haCambiado) {
                terna.push(datos);
            }
        });
        return terna;
    }

    function enviarTerna(terna, programacion, btn) {
        const urlParams = new URLSearchParams(window.location.search);
        const pasoDeNavegacion = urlParams.get('paso') || 0;
        
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
        
        $.ajax({
            url:  '<?= $this->url("examen", ["action" => "guardar-terna"]) ?>',
            type: 'POST',
            data: {
                cod_proceso:     COD_PROCESO,
                cod_paso_actual: <?= (int)($this->proceso['cod_paso_actual'] ?? 0) ?>,
                pasoUrl: pasoDeNavegacion,
                fase:            '<?= $fase ?>',
                terna:           terna,
                programacion:    programacion
            },
            success: function(response) {
                if (response.status === 'success') {
                    ToastService.success(response.message || 'Terna guardada exitosamente.');
                    
                    // Si el proceso avanzó automáticamente, redirigir al siguiente paso
                    if (response.avanzado) {
                        setTimeout(function() {
                            window.location.href = '<?= $this->url("examen", ["action" => "solicitudes", "id" => $this->proceso["cod_proceso"]]) ?>?paso=4';
                        }, 1500);
                    }
                } else {
                    ToastService.error('Error: ' + (response.message || 'No se pudo guardar.'));
                }
            },
            error: function() {
                ToastService.error('Error de comunicación con el servidor.');
            },
            complete: function() {
                btn.prop('disabled', false).html(btn.data('label-orig'));
            }
        });
    }

    // Guardar la etiqueta original de cada botón para restaurarla
    $('#btnGuardarTerna').each(function() {
        $(this).data('label-orig', $(this).html());
    });

    // ── Guardar terna completa ────────────────────────────────────
    $('#btnGuardarTerna').on('click', function() {
        const terna = recopilarTerna();
        const fecha = $('#fechaExamen').val();
        const hora  = $('#horaExamen').val();
        const fechaOriginal = "<?= $fechaExamen ?>";
        const horaOriginal  = "<?= $horaExamen ?>";

        // 1. Verificar si hubo algún cambio respecto a los valores iniciales
        let haCambiadoAlgo = false;
        const cambioProgramacion = (fecha !== fechaOriginal || hora !== horaOriginal);

        // Si no hubo cambios en la programación ni en ningún examinador
        if (cambioProgramacion || terna.length > 0) {
            haCambiadoAlgo = true;
        }

        if (!haCambiadoAlgo) {
            ToastService.warning('No se han detectado cambios para guardar.');
            return;
        }

        // 2. Si se agregó algún examinador con datos parciales, validar que ese card esté completo
        let incompleto = false;
        let tituloFaltante = false;
        let tipoInternoSinTitulo = false;
        let internoSinTituloCard = null;
        $('.examinador-card').each(function() {
            const tipo = $(this).find('.examinador-tipo').val();
            if (!tipo) {
                // Si seleccionó tipo, no hay datos parciales
                return true; // continue
            }
            // Validar según tipo: solo los campos VISIBLES del tipo seleccionado
            let nombre, colegiado, titulo;
            if (tipo === 'interno') {
                nombre    = $(this).find('.campos-interno .examinador-nombre').val().trim();
                colegiado = $(this).find('.campos-interno .examinador-colegiado').val().trim();
                titulo    = $(this).find('.campos-interno .examinador-titulo').val().trim();
            } else {
                nombre    = $(this).find('.campos-externo .examinador-nombre').val().trim();
                colegiado = $(this).find('.campos-externo .examinador-colegiado').val().trim();
                titulo    = $(this).find('.campos-externo .examinador-titulo').val().trim();
            }
            if (!nombre || !colegiado) {
                incompleto = true;
                return false; // break
            }
            if (!titulo) {
                tituloFaltante = true;
                if (tipo === 'interno') {
                    tipoInternoSinTitulo = true;
                    internoSinTituloCard = $(this);
                }
                return false; // break
            }
        });

        if (incompleto) {
            ToastService.warning('Si llena un examinador, debe completar su tipo, nombre, título y número de colegiado.');
            return;
        }

        if (tituloFaltante) {
            if (tipoInternoSinTitulo) {
                ToastService.warning('El docente interno no tiene título profesional registrado. Diríjase a la búsqueda de usuarios para editarlo. <a href="<?= $this->url('user', ['action' => 'studentSearch']) ?>" target="_blank" style="color: #8B0000; text-decoration: underline; font-weight: bold;">CLICK AQUÍ PARA EDITAR EXAMINADOR</a>');
                // Resaltar el card con el error
                if (internoSinTituloCard) {
                    internoSinTituloCard.css('border-color', '#e74c3c');
                    setTimeout(function() {
                        internoSinTituloCard.css('border-color', '#ddd');
                    }, 3000);
                }
            } else {
                ToastService.warning('El examinador externo debe tener un título profesional.');
            }
            return;
        }

        // 3. Validar duplicados si hay más de uno
        const validacion = validarExaminadoresDuplicados();
        if (validacion) {
            ToastService.error('No puede haber examinadores con el mismo número de colegiado.');
            return;
        }

        // Validar que la fecha no sea anterior a hoy
        if (cambioProgramacion && fecha) {
            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            const partes = fecha.split('-');
            const fechaSel = new Date(partes[0], partes[1] - 1, partes[2]);
            if (fechaSel < hoy) {
                ToastService.error('La fecha del examen no puede ser anterior al día de hoy.');
                return;
            }
        }

        const programacionFinal = cambioProgramacion ? { fecha: fecha, hora: hora } : null;
        console.log(programacionFinal)

        enviarTerna(terna, programacionFinal, $(this));
    });
});
