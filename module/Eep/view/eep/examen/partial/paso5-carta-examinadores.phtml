<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>
<script>
(function () {
    'use strict';

    /* ---------- Aprobar trabajo ---------- */
    var form = document.getElementById('form-aprobar-trabajo');
    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            ConfirmService.confirm(
                '¿Confirma que desea aprobar el trabajo? Se generará la carta de examinadores y no podrá deshacer esta acción.',
                function () {
                    var btn = form.querySelector('button[type="submit"]');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Generando...';

                    fetch(form.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: new FormData(form)
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (json) {
                        if (json.success) {
                            ToastService.success(json.message || 'Carta generada correctamente.');
                            setTimeout(function () { location.reload(); }, 1800);
                        } else {
                            ToastService.error(json.message || 'No se pudo aprobar el trabajo.');
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fa fa-check"></i> Aprobar y generar carta';
                        }
                    })
                    .catch(function () {
                        ToastService.error('Error de comunicación. Intenta de nuevo.');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa fa-check"></i> Aprobar y generar carta';
                    });
                }
            );
        });
    }

    /* ---------- Filtrar evidencias ---------- */
    var items = document.querySelectorAll('.item-evidencia');
    var inputBuscar = document.getElementById('input-buscar-evidencia');
    var msgVacio = document.getElementById('msg-filtro-vacio');
    var botonesFiltro = document.querySelectorAll('[data-filter]');
    var filtroActivo = 'all';

    function aplicarFiltros() {
        var texto = (inputBuscar ? inputBuscar.value : '').toLowerCase().trim();
        var visibles = 0;

        items.forEach(function (item) {
            var tipo = item.getAttribute('data-tipo');
            var txt  = item.getAttribute('data-texto') || '';

            var coincideTipo = (filtroActivo === 'all') || (tipo === filtroActivo);
            var coincideTexto = !texto || txt.indexOf(texto) !== -1;

            if (coincideTipo && coincideTexto) {
                item.style.display = '';
                visibles++;
            } else {
                item.style.display = 'none';
            }
        });

        if (msgVacio) {
            msgVacio.style.display = (visibles === 0 && items.length > 0) ? 'block' : 'none';
        }
    }

    window.filtrarEvidencias = function (tipo) {
        filtroActivo = tipo;
        botonesFiltro.forEach(function (btn) {
            if (btn.getAttribute('data-filter') === tipo) {
                btn.classList.remove('btn-default');
                btn.classList.add('btn-primary', 'active');
            } else {
                btn.classList.remove('btn-primary', 'active');
                btn.classList.add('btn-default');
            }
        });
        aplicarFiltros();
    };

    if (inputBuscar) {
        inputBuscar.addEventListener('input', aplicarFiltros);
    }
}());
</script>
