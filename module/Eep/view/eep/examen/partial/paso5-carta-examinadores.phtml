<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>
<script>
(function () {
    'use strict';
    var form = document.getElementById('form-aprobar-trabajo');
    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        ConfirmService.confirm('\u00bfConfirma que desea aprobar el trabajo? Se generar\u00e1 la carta de examinadores y no podr\u00e1 deshacer esta acci\u00f3n.', function() {
            var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Generando...';

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: new FormData(form)
        })
        .then(function (res) { return res.json(); })
        .then(function (json) {
            if (json.success) {
                ToastService.success(json.message || 'Carta generada correctamente.');
                setTimeout(function () { location.reload(); }, 1800);
            } else {
                ToastService.error(json.message || 'No se pudo aprobar el trabajo.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-check"></i> Aprobar trabajo y generar carta';
            }
        })
        .catch(function () {
            ToastService.error('Error de comunicaci\u00f3n. Intenta de nuevo.');
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-check"></i> Aprobar trabajo y generar carta';
        });
        });
    });
}());
</script>

