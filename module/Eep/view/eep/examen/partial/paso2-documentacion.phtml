                                    <th style="width: 15%;">Fecha Recepción</th>
                                    <th style="width: 15%; text-align: center;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="fila-pendiente">
                                    <td>1</td>
                                    <td>Proyecto de graduación empastado</td>
                                    <td>3 ejemplares</td>
                                    <td><span class="estado-badge estado-pendiente">Pendiente</span></td>
                                    <td>-</td>
