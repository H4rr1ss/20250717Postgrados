<script>
$(document).ready(function() {
    // Manejar click en botones de acción
    $('.table-documentos .btn-accion').on('click', function() {
        const boton = $(this);
        const grupo = boton.parent();
        const estadoSeleccionado = boton.data('estado');
        const fila = boton.closest('tr');
        const yaEstaActivo = boton.hasClass('active');
        
        // Si el botón ya está activo, lo desmarcamos (estado pendiente)
        if (yaEstaActivo) {
            aplicarEstadoPendiente(fila, grupo);
            return;
        }
        
        if (estadoSeleccionado === 'aceptar') {
            // Aceptar y colocar fecha actual
            aplicarEstadoAceptado(fila, boton, grupo);
        }
    });

    function aplicarEstadoAceptado(fila, boton, grupo) {
        // Remover clases de estado
        fila.removeClass('fila-rechazada fila-pendiente').addClass('fila-aceptada');
        
        // Actualizar botones
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        
        // Obtener fecha actual
        const fechaActual = new Date();
        const dia = String(fechaActual.getDate()).padStart(2, '0');
        const mes = String(fechaActual.getMonth() + 1).padStart(2, '0');
        const anio = fechaActual.getFullYear();
        const fechaFormateada = `${dia}/${mes}/${anio}`;
        
        // Actualizar fecha de recepción (columna 5)
        fila.find('td').eq(4).text(fechaFormateada);
        
        // Actualizar estado visual (columna 4)
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-rechazado estado-pendiente').addClass('estado-aceptado').text('Recibido');
        
        console.log('Documento recibido');
        mostrarAlertaGuardar();
    }

    function aplicarEstadoPendiente(fila, grupo) {
        // Remover clases de estado
        fila.removeClass('fila-aceptada fila-rechazada').addClass('fila-pendiente');
        
        // Desactivar todos los botones
        grupo.find('.btn-accion').removeClass('active');
        
        // Limpiar fecha de recepción
        fila.find('td').eq(4).text('-');
        
        // Actualizar estado visual
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-aceptado estado-rechazado').addClass('estado-pendiente').text('Pendiente');
        
        console.log('Documento pendiente');
        mostrarAlertaGuardar();
    }

    function mostrarAlertaGuardar() {
        $('#alertaRecordatorioGuardarDoc').fadeIn(400);
    }

    // Manejar click en guardar cambios
    $('#btnGuardarDocumentacion').on('click', function() {
        const btn = $(this);

        // Recopilar estado actual de cada fila
        const documentos = [];
        $('.table-documentos tbody tr[data-cod-requisito]').each(function() {
            const fila = $(this);
            const codRequisito = parseInt(fila.data('cod-requisito'), 10);
            const recibido     = fila.find('.btn-aceptar').hasClass('active') ? 1 : 0;

            documentos.push({
                cod_requisito: codRequisito,
                recibido:      recibido,
                observaciones: ''
            });
        });

        if (documentos.length === 0) {
            return;
        }

        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

        const codProceso = <?= isset($proceso['cod_proceso']) ? (int)$proceso['cod_proceso'] : 0 ?>;

        $.ajax({
            url: '/examen/guardarDocFisico',
            type: 'POST',
            data: {
                cod_proceso: codProceso,
                documentos:  documentos
            },
            success: function(response) {
                if (response.status === 'success') {
                    $('#alertaRecordatorioGuardarDoc').fadeOut(300);
                    mostrarToast('Recepción guardada correctamente.', 'success');
                } else {
                    mostrarToast('Error: ' + (response.message || 'No se pudo guardar.'), 'danger');
                }
            },
            error: function() {
                mostrarToast('Error de comunicación con el servidor.', 'danger');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar Recepción');
            }
        });
    });

    function mostrarToast(mensaje, tipo) {
        const id = 'toast-doc-' + Date.now();
        const html = `<div id="${id}" class="alert alert-${tipo}" role="alert"
            style="position:fixed;bottom:20px;right:20px;z-index:9999;min-width:280px;box-shadow:0 4px 12px rgba(0,0,0,.15);">
            ${mensaje}
        </div>`;
        $('body').append(html);
        setTimeout(function() { $('#' + id).fadeOut(400, function() { $(this).remove(); }); }, 3500);
    }
});
</script>