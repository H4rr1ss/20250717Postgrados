                <!-- Acciones -->
                <div style="display: flex; justify-content: flex-end; align-items: center; gap: 15px; padding: 15px 0 5px 0; border-top: 1px solid #eee; margin-top: 20px;">
                    <div id="alertaRecordatorioGuardarDoc" class="alerta-recordatorio-interna">
                        <i class="fa fa-warning"></i> * No olvides guardar tus cambios
