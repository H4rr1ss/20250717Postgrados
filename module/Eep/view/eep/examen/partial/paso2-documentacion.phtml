<!-- Toast Service -->
<script src="/js/toast-service.js"></script>

<script>
$(document).ready(function() {
    // Manejar click en botones de acción
    $('.table-documentos .btn-accion').on('click', function() {
        const boton = $(this);
        const grupo = boton.parent();
        const estadoSeleccionado = boton.data('estado');
        const fila = boton.closest('tr');
        const yaEstaActivo = boton.hasClass('active');
        
        // Si el botón ya está activo, lo desmarcamos (estado pendiente)
        if (yaEstaActivo) {
            aplicarEstadoPendiente(fila, grupo);
            return;
        }
        
        if (estadoSeleccionado === 'aceptar') {
            // Confirmar antes de marcar como aceptado
            if (confirm('¿Está seguro de marcar este documento como recibido?')) {
                // Aceptar y colocar fecha actual
                aplicarEstadoAceptado(fila, boton, grupo);
            }
        }
    });

    function aplicarEstadoAceptado(fila, boton, grupo) {
        // Remover clases de estado
        fila.removeClass('fila-rechazada fila-pendiente').addClass('fila-aceptada');
        
        // Actualizar botones
        grupo.find('.btn-accion').removeClass('active');
        boton.addClass('active');
        
        // Obtener fecha actual
        const fechaActual = new Date();
        const dia = String(fechaActual.getDate()).padStart(2, '0');
        const mes = String(fechaActual.getMonth() + 1).padStart(2, '0');
        const anio = fechaActual.getFullYear();
        const fechaFormateada = `${dia}/${mes}/${anio}`;
        
        // Actualizar fecha de recepción (columna 4 - índice 3)
        fila.find('td').eq(3).text(fechaFormateada);
        
        // Actualizar estado visual (columna 3 - índice 2)
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-rechazado estado-pendiente').addClass('estado-aceptado').text('Recibido');

        // Actualizar acciones a "Cerrado" (columna 5 - índice 4)
        fila.find('td').eq(4).html('<span class="text-muted"><i class="fa fa-lock"></i> Cerrado</span>');
        
        console.log('Documento recibido');
        mostrarAlertaGuardar();
    }

    function aplicarEstadoPendiente(fila, grupo) {
        // Remover clases de estado
        fila.removeClass('fila-aceptada fila-rechazada').addClass('fila-pendiente');
        
        // Desactivar todos los botones
        grupo.find('.btn-accion').removeClass('active');
        
        // Limpiar fecha de recepción (columna 4 - índice 3)
        fila.find('td').eq(3).text('-');
        
        // Actualizar estado visual (columna 3 - índice 2)
        const estadoBadge = fila.find('.estado-badge');
        estadoBadge.removeClass('estado-aceptado estado-rechazado').addClass('estado-pendiente').text('Pendiente');
        
        console.log('Documento pendiente');
        mostrarAlertaGuardar();
    }

    function mostrarAlertaGuardar() {
        $('#alertaRecordatorioGuardarDoc').fadeIn(400);
    }

    // Manejar click en guardar cambios
    $('#btnGuardarDocumentacion').on('click', function() {
        const btn = $(this);

        // Recopilar estado actual de cada fila, solo si cambió
        const documentos = [];
        $('.table-documentos tbody tr[data-cod-requisito]').each(function() {
            const fila = $(this);
            const codRequisito = parseInt(fila.data('cod-requisito'), 10);
            const estadoInicial = parseInt(fila.attr('data-estado-inicial'), 10);
            const recibido      = (fila.find('.btn-aceptar').hasClass('active') || fila.find('.fa-lock').length > 0) ? 1 : 0;

            // Solo agregar si el estado actual es diferente al inicial
            if (recibido !== estadoInicial) {
                documentos.push({
                    cod_requisito: codRequisito,
                    recibido:      recibido
                });
            }
        });

        if (documentos.length === 0) {
            ToastService.info('No hay cambios pendientes por guardar.');
            return;
        }

        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

        const codProceso = <?= isset($proceso['cod_proceso']) ? (int)$proceso['cod_proceso'] : 0 ?>;

        console.log("prueba de codProceso ", codProceso);
        console.log("prueba de documentos ", documentos);

        $.ajax({
            url:      '<?= $this->url("examen", ["action" => "guardarDocFisico"]) ?>',
            type:     'POST',
            dataType: 'json',
            async:    true,
            timeout:  10000,
            data: {
                cod_proceso: '<?= $this->proceso["cod_proceso"] ?? null ?>',
                cod_paso_actual: '<?= $this->proceso["cod_paso_actual"] ?? null ?>',
                cod_tipo_examen: '<?= $this->proceso["tipo_cod_examen"] ?? null ?>',
                fase:            '<?= $fase ?>',
                documentos:  documentos ?? []
            },
            success: function(response) {
                if (response.status === 'success') {
                    // Actualizar el estado inicial de las filas enviadas
                    $('.table-documentos tbody tr[data-cod-requisito]').each(function() {
                        const fila = $(this);
                        const recibido = (fila.find('.btn-aceptar').hasClass('active') || fila.find('.fa-lock').length > 0) ? 1 : 0;
                        fila.attr('data-estado-inicial', recibido);
                    });
                    
                    $('#alertaRecordatorioGuardarDoc').fadeOut(300);
                    ToastService.success(response.message || 'Recepción guardada correctamente.');
                    
                    // Si el proceso avanzó, redirigir al siguiente paso
                    if (response.avanzado) {
                        setTimeout(function() {
                            window.location.href = '<?= $this->url("examen", ["action" => "solicitudes", "id" => $this->proceso["cod_proceso"]]) ?>?paso=3';
                        }, 1000);
                    }
                } else {
                    ToastService.error('Error: ' + (response.message || 'No se pudo guardar.'));
                }
            },
            error: function() {
                ToastService.error('Error de comunicación con el servidor.');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar Recepción');
            }
        });
    });
});
</script>