<!-- Paso 3: Entrega de Documentación -->
<div class="row" style="margin-top: 20px;">
    <div class="col-lg-12">
        <div class="panel-revision">
            <div class="panel-revision-heading">
                Entrega de Documentación Física
            </div>
            <div class="panel-revision-body" style="padding: 20px;">
                
                <!-- Estado de entrega -->
                <div class="row">
                    <div class="col-md-12">
                        <div class="alert alert-info" style="display: flex; align-items: center; gap: 15px;">
                            <i class="fa fa-info-circle fa-2x"></i>
                            <div>
                                <strong>Instrucciones:</strong> El estudiante debe entregar la documentación física en la oficina de Postgrados durante horario hábil (8:00 - 16:00 hrs).
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Checklist de documentos físicos -->
                <div class="row" style="margin-top: 20px;">
                    <div class="col-md-12">
                        <h5 style="font-weight: 600; margin-bottom: 15px;">Checklist de Documentos Físicos</h5>
                        <table class="table table-bordered" style="font-size: 13px;">
                            <thead style="background: #f5f5f5;">
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 45%;">Documento</th>
                                    <th style="width: 20%;">Copias Requeridas</th>
                                    <th style="width: 15%;">Recibido</th>
                                    <th style="width: 15%;">Fecha Recepción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td>Proyecto de graduación empastado</td>
                                    <td>3 ejemplares</td>
                                    <td>
                                        <label class="switch switch-sm">
                                            <input type="checkbox">
                                            <span class="slider"></span>
                                        </label>
                                    </td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td>2</td>
                                    <td>CD con versión digital</td>
                                    <td>2 copias</td>
                                    <td>
                                        <label class="switch switch-sm">
                                            <input type="checkbox">
                                            <span class="slider"></span>
                                        </label>
                                    </td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td>3</td>
                                    <td>Carta de autorización del asesor (original)</td>
                                    <td>1 original</td>
                                    <td>
                                        <label class="switch switch-sm">
                                            <input type="checkbox">
                                            <span class="slider"></span>
                                        </label>
                                    </td>
                                    <td>-</td>
                                </tr>
                                <tr>
                                    <td>4</td>
                                    <td>Constancia de cierre de pensum</td>
                                    <td>1 original</td>
                                    <td>
                                        <label class="switch switch-sm">
                                            <input type="checkbox">
                                            <span class="slider"></span>
                                        </label>
                                    </td>
                                    <td>-</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Observaciones -->
                <div class="row" style="margin-top: 20px;">
                    <div class="col-md-12">
                        <h5 style="font-weight: 600; margin-bottom: 10px;">Observaciones</h5>
                        <textarea class="form-control" rows="3" placeholder="Agregar observaciones sobre la entrega de documentación..."></textarea>
                    </div>
                </div>

                <!-- Acciones -->
                <div style="text-align: right; padding: 15px 0 5px 0; border-top: 1px solid #eee; margin-top: 20px;">
                    <button class="btn btn-primary">
                        <i class="fa fa-save"></i> Guardar Recepción
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
