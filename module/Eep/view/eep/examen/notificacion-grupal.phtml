<script src="<?= $this->basePath('js/toast-service.js') ?>"></script>
<script>
$(document).ready(function() {
    // Seleccionar/deseleccionar todos
    $('#seleccionarTodos').on('change', function() {
        $('.sel-estudiante').prop('checked', $(this).is(':checked'));
    });

    // ── Gestión de correos CC como tags ───────────────
    var $input = $('#ngCorreoInput');
    var $tagsContainer = $('#ngCorreosTags');
    var $hidden = $('#ngCorreosCcHidden');
    var correos = [];

    function emailRegex() { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/; }

    function renderTags() {
        $tagsContainer.empty();
        correos.forEach(function(c, idx) {
            var tag = $('<span style="font-size: 13px; display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:3px; background:#51A0B8; color:#fff; font-weight:600;">')
                .text(c)
                .append(
                    $('<i class="fa fa-times" style="cursor:pointer; margin-left:4px; opacity:0.9;">').on('click', function() {
                        correos.splice(idx, 1);
                        renderTags();
                    })
                );
            $tagsContainer.append(tag);
        });
        $hidden.val(correos.join(','));
    }

    function agregarCorreo() {
        var val = $input.val().trim();
        if (!val) return;
        if (!emailRegex().test(val)) {
            ToastService.error('El correo "' + val + '" no tiene formato válido.');
            return;
        }
        if (correos.indexOf(val) !== -1) {
            ToastService.warning('El correo "' + val + '" ya está agregado.');
            $input.val('').focus();
            return;
        }
        correos.push(val);
        $input.val('').focus();
        renderTags();
    }

    $('#btnAgregarCorreo').on('click', agregarCorreo);
    $input.on('keypress', function(e) {
        if (e.which === 13) {
            e.preventDefault();
            agregarCorreo();
        }
    });

    function obtenerCorreosCc() {
        return correos.join(',');
    }

    // ── Helpers comunes ─────────────────────────────
    function obtenerDatosFormulario() {
        return {
            fecha: $('#ngFecha').val(),
            hora: $('#ngHora').val(),
            lugar: $('#ngLugar').val().trim(),
            info_extra: $('#ngInfoExtra').val()
        };
    }

    function validarFormulario(datos) {
        if (!datos.fecha || !datos.hora || !datos.lugar) {
            ToastService.warning('Fecha, hora y lugar son obligatorios.');
            return false;
        }
        var hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        var partes = datos.fecha.split('-');
        var fechaSel = new Date(partes[0], partes[1] - 1, partes[2]);
        if (fechaSel < hoy) {
            ToastService.warning('La fecha no puede ser anterior al día de hoy.');
            return false;
        }
        return true;
    }

    // ── Vista previa del correo ──────────────────────
    $('#btnVistaPreviaGrupal').on('click', function() {
        var datos = obtenerDatosFormulario();
        if (!validarFormulario(datos)) return;

        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Cargando...');

        $.ajax({
            url: '<?= $this->url("examen", ["action" => "preview-notificacion-grupal"]) ?>',
            method: 'POST',
            data: datos,
            dataType: 'json',
            success: function(resp) {
                if (resp.success && resp.html) {
                    $('#previewAsuntoGrupal').text(resp.asunto || '');
                    $('#previewCuerpoGrupal').html(resp.html);

                    if (correos.length > 0) {
                        $('#previewCcGrupalTexto').text(correos.join(', '));
                        $('#previewCcGrupal').show();
                    } else {
                        $('#previewCcGrupal').hide();
                    }

                    $('#modalVistaPreviaGrupal').modal('show');
                } else {
                    ToastService.error(resp.message || 'No se pudo generar la vista previa.');
                }
            },
            error: function() {
                ToastService.error('Error de conexión al obtener la vista previa.');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-eye"></i> Vista previa del correo');
            }
        });
    });

    // ── Enviar notificación grupal ───────────────────
    $('#btnEnviarNotificacionGrupal').on('click', function() {
        var btn = $(this);
        var seleccionados = [];
        $('.sel-estudiante:checked').each(function() {
            seleccionados.push($(this).val());
        });

        if (seleccionados.length === 0) {
            ToastService.warning('Debe seleccionar al menos un estudiante.');
            return;
        }

        var datos = obtenerDatosFormulario();
        if (!validarFormulario(datos)) return;

        ConfirmService.confirm('¿Confirma que desea enviar la notificación a ' + seleccionados.length + ' estudiante(s)?', function() {
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando...');

        $.ajax({
            url: '<?= $this->url("examen", ["action" => "enviar-notificacion-grupal"]) ?>',
            method: 'POST',
            data: {
                cod_procesos: seleccionados,
                fecha: datos.fecha,
                hora: datos.hora,
                lugar: datos.lugar,
                info_extra: datos.info_extra,
                correos_cc: obtenerCorreosCc()
            },
            dataType: 'json',
            success: function(resp) {
                if (resp.success) {
                    var html = '<div class="alert alert-success">' +
                        '<h4><i class="fa fa-check-circle"></i> ' + resp.message + '</h4>' +
                        '<p><strong>Enviados:</strong> ' + resp.enviados + '</p>' +
                        '<p><strong>Fallidos:</strong> ' + resp.fallidos + '</p>';
                    if (resp.errores && resp.errores.length > 0) {
                        html += '<ul>';
                        resp.errores.forEach(function(err) {
                            html += '<li>' + err + '</li>';
                        });
                        html += '</ul>';
                    }
                    html += '</div>';
                    $('#resumenNotificacion').html(html).show();
                } else {
                    ToastService.error(resp.message || 'Error al enviar la notificación.');
                }
            },
            error: function() {
                ToastService.error('Error de conexión. Inténtelo de nuevo.');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-paper-plane"></i> Enviar Notificación a Seleccionados');
            }
        });
        });
    });
});
</script>
