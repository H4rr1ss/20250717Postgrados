<script>
$(document).ready(function() {
    // Seleccionar/deseleccionar todos
    $('#seleccionarTodos').on('change', function() {
        $('.sel-estudiante').prop('checked', $(this).is(':checked'));
    });

    // ── Helpers comunes ─────────────────────────────
    function obtenerDatosFormulario() {
        return {
            fecha: $('#ngFecha').val(),
            hora: $('#ngHora').val(),
            lugar: $('#ngLugar').val().trim(),
            info_extra: $('#ngInfoExtra').val()
        };
    }

    function validarFormulario(datos) {
        if (!datos.fecha || !datos.hora || !datos.lugar) {
            alert('Fecha, hora y lugar son obligatorios.');
            return false;
        }
        var hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        var partes = datos.fecha.split('-');
        var fechaSel = new Date(partes[0], partes[1] - 1, partes[2]);
        if (fechaSel < hoy) {
            alert('La fecha no puede ser anterior al día de hoy.');
            return false;
        }
        return true;
    }

    // ── Vista previa del correo ──────────────────────
    $('#btnVistaPreviaGrupal').on('click', function() {
        var datos = obtenerDatosFormulario();
        if (!validarFormulario(datos)) return;

        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Cargando...');

        $.ajax({
            url: '<?= $this->url("examen", ["action" => "preview-notificacion-grupal"]) ?>',
            method: 'POST',
            data: datos,
            dataType: 'json',
            success: function(resp) {
                if (resp.success && resp.html) {
                    $('#previewAsuntoGrupal').text(resp.asunto || '');
                    $('#previewCuerpoGrupal').html(resp.html);
                    $('#modalVistaPreviaGrupal').modal('show');
                } else {
                    alert(resp.message || 'No se pudo generar la vista previa.');
                }
            },
            error: function() {
                alert('Error de conexión al obtener la vista previa.');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-eye"></i> Vista previa del correo');
            }
        });
    });

    // ── Enviar notificación grupal ───────────────────
    $('#btnEnviarNotificacionGrupal').on('click', function() {
        var btn = $(this);
        var seleccionados = [];
        $('.sel-estudiante:checked').each(function() {
            seleccionados.push($(this).val());
        });

        if (seleccionados.length === 0) {
            alert('Debe seleccionar al menos un estudiante.');
            return;
        }

        var datos = obtenerDatosFormulario();
        if (!validarFormulario(datos)) return;

        if (!confirm('¿Confirma que desea enviar la notificación a ' + seleccionados.length + ' estudiante(s)?')) {
            return;
        }

        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando...');

        $.ajax({
            url: '<?= $this->url("examen", ["action" => "enviar-notificacion-grupal"]) ?>',
            method: 'POST',
            data: {
                cod_procesos: seleccionados,
                fecha: datos.fecha,
                hora: datos.hora,
                lugar: datos.lugar,
                info_extra: datos.info_extra,
                correos_cc: $('#ngCorreosCc').val()
            },
            dataType: 'json',
            success: function(resp) {
                if (resp.success) {
                    var html = '<div class="alert alert-success">' +
                        '<h4><i class="fa fa-check-circle"></i> ' + resp.message + '</h4>' +
                        '<p><strong>Enviados:</strong> ' + resp.enviados + '</p>' +
                        '<p><strong>Fallidos:</strong> ' + resp.fallidos + '</p>';
                    if (resp.errores && resp.errores.length > 0) {
                        html += '<ul>';
                        resp.errores.forEach(function(err) {
                            html += '<li>' + err + '</li>';
                        });
                        html += '</ul>';
                    }
                    html += '</div>';
                    $('#resumenNotificacion').html(html).show();
                } else {
                    alert(resp.message || 'Error al enviar la notificación.');
                }
            },
            error: function() {
                alert('Error de conexión. Inténtelo de nuevo.');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fa fa-paper-plane"></i> Enviar Notificación a Seleccionados');
            }
        });
    });
});
</script>
