$this->headTitle('Carta de Examinadores — Proceso ' . (int) ($proceso['cod_proceso'] ?? 0));

$nombreEstudiante = trim(($proceso['nombres'] ?? '') . ' ' . ($proceso['apellidos'] ?? ''));
$totalEvidencias  = count($evidencias ?? []);
$ultimaFecha      = null;
foreach ($evidencias ?? [] as $ev) {
    $f = strtotime($ev['fecha_subida'] ?? '');
    if ($f && (!$ultimaFecha || $f > $ultimaFecha)) {
        $ultimaFecha = $f;
    }
}
$diasDesdeUltima = $ultimaFecha ? floor((time() - $ultimaFecha) / 86400) : null;
