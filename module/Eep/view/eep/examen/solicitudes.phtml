<script>
$(document).ready(function() {
    // Abrir modal de detalle
    $('.btn-info-sol').on('click', function() {
        var completado = $(this).data('completado') == '1';
        var carne  = $(this).data('carne');
        var nombre = $(this).data('nombre');
        var fecha  = $(this).data('fecha');
        var tipo   = $(this).data('tipo');
        var estado = $(this).data('estado');

        if (completado) {
            $('#modalDetalleTitulo').text('Resumen del Proceso');
            $('#bloqueActivo').hide();
            $('#bloqueCompletado').show();
            $('#resNombre').text(nombre);
            $('#resCarne').text(carne);
            $('#resTipo').text(tipo || '-');
            $('#resFecha').text(fecha);
            $('#resFechaCompletado').text($(this).data('fecha-completado') || '-');
        } else {
            $('#modalDetalleTitulo').text('Detalle de Solicitud');
            $('#bloqueActivo').show();
            $('#bloqueCompletado').hide();
            $('#detalleCarne').text(carne);
            $('#detalleNombre').text(nombre);
            $('#detalleFecha').text(fecha);
            $('#detalleTipo').text(tipo || '-');
            var estadoClases = {
                'Completado':  'label-success',
                'En progreso': 'label-warning',
                'Rechazado':   'label-danger',
                'Pendiente':   'label-default'
            };
            var estadoClass = estadoClases[estado] || 'label-default';
            $('#detalleEstado').html('<span class="label ' + estadoClass + '" style="font-size:13px;">' + estado + '</span>');
        }

        $('#modalDetalleSolicitud').modal('show');
    });
    
    // Aprobar solicitud
    $('#btnAprobar').on('click', function() {
        ConfirmService.confirm('¿Está seguro de aprobar esta solicitud?', function() {
            // Aquí iría la llamada AJAX para aprobar
            $('#modalRevisarSolicitud').modal('hide');
        });
    });

    // Rechazar solicitud
    $('#btnRechazar').on('click', function() {
        ConfirmService.confirm('¿Está seguro de rechazar esta solicitud?', function() {
            // Aquí iría la llamada AJAX para rechazar
            $('#modalRevisarSolicitud').modal('hide');
        });
    });
});
</script>
