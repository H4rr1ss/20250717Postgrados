<script>
$(document).ready(function() {
    // Búsqueda de solicitudes
    $('#buscarSolicitud').on('keyup', function() {
        var valor = $(this).val().toLowerCase();
        $('#tablaSolicitudes tbody tr').filter(function() {
            $(this).toggle($(this).find('td:first').text().toLowerCase().indexOf(valor) > -1);
        });
    });
    
    // Filtro por estado
    $('#filtroEstado').on('change', function() {
        var estado = $(this).val().toLowerCase();
        if (estado === '') {
            $('#tablaSolicitudes tbody tr').show();
        } else {
            $('#tablaSolicitudes tbody tr').filter(function() {
                $(this).toggle($(this).find('td:eq(2)').text().toLowerCase().indexOf(estado) > -1);
            });
        }
    });
    
    // Abrir modal de detalle
    $('.btn-info-sol').on('click', function() {
        var fila = $(this).closest('tr');
        var carne = fila.find('td:eq(0)').text();
        var fecha = fila.find('td:eq(1)').text();
        var estado = fila.find('td:eq(2)').text();
        
        $('#detalleCarne').text(carne);
        $('#detalleFecha').text(fecha);
        $('#detalleEstado').text(estado);
        
        $('#modalRevisarSolicitud').modal('show');
    });
    
    // Aprobar solicitud
    $('#btnAprobar').on('click', function() {
        if (confirm('¿Está seguro de aprobar esta solicitud?')) {
            // Aquí iría la llamada AJAX para aprobar
            $('#modalRevisarSolicitud').modal('hide');
        }
    });
    
    // Rechazar solicitud
    $('#btnRechazar').on('click', function() {
        if (confirm('¿Está seguro de rechazar esta solicitud?')) {
            // Aquí iría la llamada AJAX para rechazar
            $('#modalRevisarSolicitud').modal('hide');
        }
    });
});
</script>
