<script>
$(document).ready(function() {
    function aplicarFiltros() {
        var carne = $('#buscarSolicitud').val();
        var estado = $('#filtroEstado').val();
        var url = '<?= $this->url('examen', ['action' => 'solicitudes']) ?>';
        window.location.href = url + '?carne=' + carne + '&estado=' + estado;
    }

    $('#filtroEstado').on('change', aplicarFiltros);
    $('#buscarSolicitud').on('keypress', function(e) {
        if (e.which == 13) aplicarFiltros();
    });
});
</script>

