<script>
$(function() {
    $('.btn-abrir-eval').on('click', function() {
        var codProceso = $(this).data('proceso');
        ConfirmService.confirm('¿Abrir evaluación? Se generará un link para los 3 examinadores.', function() {
            $.post('/examen/abrir-evaluacion', { cod_proceso: codProceso }, function(res) {
                if (res.status === 'success') {
                    var urlCompleta = window.location.origin + '/eval-privado/' + codProceso + '?cod=' + res.codigo;
                    ToastService.success('Evaluación abierta correctamente. Link para compartir con los examinadores: ' + urlCompleta);
                    location.reload();
                } else {
                    ToastService.error('Error: ' + res.message);
                }
            });
        });
    });

    $('.btn-cerrar-eval').on('click', function() {
        var codProceso = $(this).data('proceso');
        var msg = '¿Cerrar evaluación?';
        ConfirmService.confirm(msg, function() {
            $.post('/examen/cerrar-evaluacion', { cod_proceso: codProceso }, function(res) {
                if (res.status === 'success') {
                    location.reload();
                } else {
                    ToastService.error('Error: ' + res.message);
                }
            });
        });
    });

    $('.btn-ver-link').on('click', function() {
        var codProceso = $(this).data('proceso');
        var codigo = $(this).data('codigo');

        if (!codigo) {
            ToastService.warning('Debe presionar "Abrir examen" primero para generar el link de evaluación.');
            return;
        }

        var url = window.location.origin + '/eval-privado/' + codProceso + '?cod=' + codigo;
        $('#inputLink').val(url);
        $('#modalLink').modal('show');
    });

    $('#btnCopiarLink').on('click', function() {
        var input = document.getElementById('inputLink');
        input.select();
        document.execCommand('copy');
        $(this).text('Copiado!');
        setTimeout(function() { $('#btnCopiarLink').text('Copiar link'); }, 2000);
    });

    var codProcesoReprog = null;

    $('.btn-reprogramar').on('click', function() {
        codProcesoReprog = $(this).data('proceso');
        var reprog = $(this).data('reprogramaciones');
        var restantes = 2 - reprog;
        $('#reprog-contador').text('Reprogramación #' + (reprog + 1) + ' de 2. Quedan ' + restantes + ' intento' + (restantes > 1 ? 's' : '') + '.');
        $('#inputFechaReprog').val('');
        $('#inputHoraReprog').val('');
        $('#modalReprogramar').modal('show');
    });

        $('#btnConfirmarReprog').on('click', function() {
        if (!codProcesoReprog) return;

        var fecha = $('#inputFechaReprog').val();
        var hora = $('#inputHoraReprog').val();

        if (!fecha) {
            ToastService.warning('Debe ingresar la fecha del examen.');
            return;
        }
        if (!hora) {
            ToastService.warning('Debe ingresar la hora del examen.');
            return;
        }

        var btn = $(this);
        btn.prop('disabled', true).text('Procesando...');

        $.post('/examen/reprogramar-examen-privado', {
            cod_proceso: codProcesoReprog,
            fecha_examen: fecha,
            hora_examen: hora
        }, function(res) {
            btn.prop('disabled', false).text('Reprogramar');
            $('#modalReprogramar').modal('hide');
            if (res.status === 'success') {
                ToastService.success(res.message);
                location.reload();
            } else {
                ToastService.error('Error: ' + res.message);
            }
        }).fail(function() {
            btn.prop('disabled', false).text('Reprogramar');
            ToastService.error('Error de conexión al reprogramar el examen.');
        });
    });

    // === Sustituir Examinador ===
    var codProcesoSustituir = null;
    var posicionSustituir = null;
    var docentesInternos = [];

    // Cargar lista de docentes internos
    function cargarDocentes() {
        var $btn = $('#btnRecargarDocentes');
        $btn.prop('disabled', true).find('i').addClass('fa-spin');

        $.get('/examen/lista-docentes', function(res) {
            if (res.status === 'success' && res.docentes) {
                docentesInternos = res.docentes;
                var $select = $('#selectDocente');
                $select.empty().append('<option value="">-- Seleccione --</option>');
                res.docentes.forEach(function(d) {
                    $select.append('<option value="' + d.cod_usuario + '" data-colegiado="' + (d.colegiado || '') + '" data-titulo="' + (d.titulo || '') + '" data-correo="' + (d.correo || '') + '">' + d.nombre_completo + '</option>');
                });

                // Limpiar estado actual
                $('#selectDocente').val('');
                $('#datosDocenteSeleccionado').hide();
                $('#alertaDatosIncompletos').hide();
                $('#btnConfirmarSustituir').prop('disabled', true);
            }
        }).always(function() {
            $btn.prop('disabled', false).find('i').removeClass('fa-spin');
        }).fail(function() {
            ToastService.error('Error al recargar la lista de docentes.');
        });
    }

    cargarDocentes();

    $('#btnRecargarDocentes').on('click', function() {
        cargarDocentes();
    });

    $('.btn-previsualizar-acta').on('click', function() {
        var url = $(this).data('url');
        $('#iframePrevisualizarActa').attr('src', url);
        $('#modalPrevisualizarActa').modal('show');
    });

    $('#modalPrevisualizarActa').on('hidden.bs.modal', function() {
        $('#iframePrevisualizarActa').attr('src', '');
    });

    $('.btn-sustituir-examinador').on('click', function() {
        codProcesoSustituir = $(this).data('proceso');
        posicionSustituir = $(this).data('posicion');
        var nombre = $(this).data('nombre');
        $('#sustituir-nombre-actual').text(nombre);
        $('#selectDocente').val('');
        $('#datosDocenteSeleccionado').hide();
        $('#alertaColegiado').hide();
        $('#btnConfirmarSustituir').prop('disabled', true);
        $('#modalSustituir').modal('show');
    });

    $('#selectDocente').on('change', function() {
        var codUsuario = parseInt($(this).val(), 10);
        if (!codUsuario) {
            $('#datosDocenteSeleccionado').hide();
            $('#alertaDatosIncompletos').hide();
            $('#btnConfirmarSustituir').prop('disabled', true);
            return;
        }

        var $opt = $(this).find('option:selected');
        var colegiado = $opt.data('colegiado') || '';
        var titulo = $opt.data('titulo') || '';
        var correo = $opt.data('correo') || '';
        var nombre = $opt.text();

        $('#docente-nombre').text(nombre);
        $('#docente-colegiado').text(colegiado || '—');
        $('#docente-titulo').text(titulo || '—');
        $('#docente-correo').text(correo || '—');
        $('#datosDocenteSeleccionado').show();

        var faltantes = [];
        if (!colegiado) faltantes.push('número de colegiado');
        if (!titulo) faltantes.push('título profesional');
        if (!correo) faltantes.push('correo electrónico');
        if (!nombre || nombre === '-- Seleccione --') faltantes.push('nombre completo');

        if (faltantes.length > 0) {
            var mensaje = 'El docente o secretario seleccionado no puede ser examinador sustituto porque le falta: ' + faltantes.join(', ') + '.';
            $('#mensajeDatosIncompletos').text(mensaje);
            $('#alertaDatosIncompletos').show();
            $('#btnConfirmarSustituir').prop('disabled', true);
        } else {
            $('#alertaDatosIncompletos').hide();
            $('#btnConfirmarSustituir').prop('disabled', false);
        }
    });

    $('#btnConfirmarSustituir').on('click', function() {
        if (!codProcesoSustituir || !posicionSustituir) return;

        var codUsuario = parseInt($('#selectDocente').val(), 10);
        if (!codUsuario) {
            ToastService.warning('Debe seleccionar un docente o secretario.');
            return;
        }

        var $opt = $('#selectDocente option:selected');
        var colegiado = $opt.data('colegiado') || '';
        var titulo = $opt.data('titulo') || '';
        var correo = $opt.data('correo') || '';
        var nombre = $opt.text();

        var faltantes = [];
        if (!colegiado) faltantes.push('número de colegiado');
        if (!titulo) faltantes.push('título profesional');
        if (!correo) faltantes.push('correo electrónico');
        if (!nombre || nombre === '-- Seleccione --') faltantes.push('nombre completo');

        if (faltantes.length > 0) {
            ToastService.error('El docente o secretario seleccionado no puede ser examinador sustituto porque le falta: ' + faltantes.join(', ') + '. Edite el usuario antes de continuar.');
            return;
        }

        // Validar que no esté duplicado en la terna actual
        var duplicado = false;
        $('.btn-sustituir-examinador[data-proceso="' + codProcesoSustituir + '"]').each(function() {
            var codExistente = parseInt($(this).data('cod-usuario'), 10);
            if (codExistente && codExistente === codUsuario) {
                duplicado = true;
                return false; // break
            }
        });
        if (duplicado) {
            ToastService.error('El docente o secretario seleccionado ya es examinador de este proceso. No puede haber duplicados en la terna.');
            return;
        }

        var datos = {
            cod_proceso: codProcesoSustituir,
            posicion: posicionSustituir,
            tipo: 'interno',
            cod_usuario: codUsuario,
            colegiado: colegiado,
            titulo: titulo,
            correo: correo
        };

        var btn = $(this);
        btn.prop('disabled', true).text('Sustituyendo...');

        $.post('/examen/sustituir-examinador', datos, function(res) {
            btn.prop('disabled', false).text('Sustituir');
            $('#modalSustituir').modal('hide');
            if (res.status === 'success') {
                ToastService.success(res.message);
                location.reload();
            } else {
                ToastService.error('Error: ' + res.message);
            }
        }).fail(function() {
            btn.prop('disabled', false).text('Sustituir');
            ToastService.error('Error de conexión al sustituir el examinador.');
        });
    });
});
</script>

