<script>
(function () {
    var btn   = document.getElementById('btnCancelarProceso');
    var modal = $('#modalCancelarProceso');
    var confirmBtn = document.getElementById('btnConfirmarCancelacion');
    var motivoInput = document.getElementById('motivoCancelacion');

    btn.addEventListener('click', function () {
        modal.modal('show');
    });

    confirmBtn.addEventListener('click', function () {
        var codProceso = btn.getAttribute('data-proceso');
        var motivo = motivoInput.value.trim();

        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Procesando...';

        $.ajax({
            url: '<?= $this->url('cancelar-proceso-privado') ?>',
            type: 'POST',
            data: {
                cod_proceso: codProceso,
                motivo: motivo
            },
            dataType: 'json',
            success: function (res) {
                modal.modal('hide');
                if (res.status === 'success') {
                    ToastService.success(res.message);
                    setTimeout(function () {
                        window.location.href = '<?= $this->url('examen', ['action' => 'solicitudes']) ?>?cod_tipo_examen=<?= (int)$this->codTipoExamenFase ?>';
                    }, 1500);
                } else {
                    ToastService.error('Error: ' + res.message);
                }
            },
            error: function (xhr) {
                modal.modal('hide');
                var msg = (xhr.responseJSON && xhr.responseJSON.message)
                          ? xhr.responseJSON.message
                          : 'Ocurrió un error inesperado.';
                ToastService.error('Error: ' + msg);
            },
            complete: function () {
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="fa fa-times-circle"></i> Confirmar cancelación';
            }
        });
    });
})();
</script>
