                </div>

                <div class="text-center" style="margin-top: 25px;">
                    <button type="button" class="btn btn-guardar" id="btnGuardarEvaluacion">
                        <i class="fa fa-save"></i> Guardar Evaluación
                    </button>
                </div>
            </form>

            <div id="mensajeExito" class="success-msg" style="display: none; margin-top: 20px; text-align: center;">
                <i class="fa fa-check-circle"></i> <strong>Evaluación guardada correctamente.</strong><br>
                Puede cerrar esta ventana.
            </div>

            <script>
            document.getElementById('btnGuardarEvaluacion').addEventListener('click', function() {
                var btn = this;
                var form = document.getElementById('formEvaluacion');
                var inputs = form.querySelectorAll('input[type="number"]');
                var errores = [];

                inputs.forEach(function(input) {
                    var valor = parseFloat(input.value);
                    var nombre = input.closest('tr').querySelector('td:nth-child(2)').innerText.trim().split('\n')[0];
                    var maximo = parseFloat(input.getAttribute('data-max')) || 10;
                    if (isNaN(valor) || valor < 0) {
                        errores.push('El campo "' + nombre + '" no puede ser negativo.');
                        input.style.borderColor = 'red';
                    } else if (valor > maximo) {
                        errores.push('El campo "' + nombre + '" no puede ser mayor a ' + maximo + '.');
                        input.style.borderColor = 'red';
                    } else {
                        input.style.borderColor = '';
                    }
                });

                if (errores.length > 0) {
                    ToastService.error('Revise los campos resaltados en rojo. Los valores deben estar dentro del rango indicado.');
                    return;
                }

                btn.disabled = true;
                btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Guardando...';

                var formData = new FormData(form);
                var data = {};
                formData.forEach(function(value, key) {
                    if (key.indexOf('respuestas') === 0) {
                        var match = key.match(/respuestas\[(\d+)\]\[(\w+)\]/);
                        if (match) {
                            var idx = match[1];
                            var field = match[2];
                            if (!data.respuestas) data.respuestas = [];
                            if (!data.respuestas[idx]) data.respuestas[idx] = {};
                            data.respuestas[idx][field] = value;
                        }
                    } else {
                        data[key] = value;
                    }
                });

                $.ajax({
                    url: '/examen/guardar-evaluacion-examinador',
                    type: 'POST',
                    data: data,
                    dataType: 'json',
                    success: function(res) {
                        if (res.status === 'success') {
                            document.getElementById('mensajeExito').style.display = 'block';
                            btn.style.display = 'none';
                        } else {
                            ToastService.error('Error: ' + res.message);
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fa fa-save"></i> Guardar Evaluación';
                        }
                    },
                    error: function() {
                        ToastService.error('Error de conexión');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa fa-save"></i> Guardar Evaluación';
                    }
                });
            });
            </script>
