    //COURSES-SECTIONS DYNAMIC CHANGE
    var tree3 = {"": {"": "<?= GRF::EMPTY_OPTION_LABEL ?>"}};
    var courseElement = "#<?= GRF::COURSE ?>";
    var sectionElement = "#<?= GRF::SECTION ?>";
    $(courseElement).change(function () {
        selected = $(courseElement).val();
        sections = tree3[selected];
        options = "";
//        $.each(sections, function (key, value) {
//            options = options + "<option value=\"" + key + "\">" + value + "</option>";
//        });
        for (var key in sections) {
            options = options + "<option value=\"" + key + "\">" + sections[key] + "</option>";
        }
        $(sectionElement).html(options);
        $(sectionElement).val("");
    });
    $(courseElement).trigger("change");
    //AJAX REQUEST

//    $(document).ready(function () {
    $("#<?= GRF::UPDATE ?>").on("click", function (event) {
        pensumName = $(pensumElement).attr('name');
        pensumValue = $(pensumElement).val();
        cohortName = $(cohortElement).attr('name');
        cohortValue = $(cohortElement).val();
        startDateName = $("[id='<?= GRF::START_DATE ?>'").attr('name');
        startDateValue = $("[id='<?= GRF::START_DATE ?>'").val();
        finishDateName = $("[id='<?= GRF::FINISH_DATE ?>'").attr('name');
        finishDateValue = $("[id='<?= GRF::FINISH_DATE ?>'").val();
        data = {};
        data[pensumName] = pensumValue;
        data[cohortName] = cohortValue;
        data[startDateName] = startDateValue;
        data[finishDateName] = finishDateValue;
        $.ajax({
            url: '/treasury/ajaxGetCoursesTimetables',
            type: 'POST',
            dataType: 'json',
            async: true,
            data: data,
            success: function (response, status) {
                if (response.status == false) {
                    $("#updateMessages").html(response.message);
                } else {
                    $("#updateMessages").html("");
                    options = "";
                    data = response.data;
                    $.each(data.courses, function (key, value) {
                        options = options + "<option value=\"" + key + "\">" + value + "</option>";
                    });
                    $(courseElement).html(options);
                    options = "";
                    $.each(data.sections, function (key, value) {
                        console.log("Seccion " + key + ": " + value);
                        options = options + "<option value=\"" + key + "\">" + value + "</option>";
                    });
                    $(sectionElement).html(options);
                    $(courseElement).val("");
                    $(sectionElement).val("");
                    tree3 = data.tree;
                    $(clearDataClass).removeAttr('disabled');
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                alert('No se pudo realizar la consulta');
            }
        });
    });
    //});

    $(clearSelectionClass).change(function () {
        $(clearDataClass).html("<option><?= GRF::EMPTY_OPTION_LABEL ?></option>");
        $(clearDataClass).attr('disabled', 'disabled');
    });

</script>