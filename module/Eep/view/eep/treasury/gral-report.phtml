<script type="text/javascript">
    //DEGREE AND CAREER DYNAMIC CHANGE
    var tree = <?= $form->getJsCareerDegreeTree() ?>;
    var degreeElement = "#<?= GRF::ACADEMIC_DEGREE ?>";
    var pensumElement = "#<?= GRF::PENSUM ?>";
    var clearSelectionClass = ".<?= GRF::CLEAR_COURSE_SELECTION ?>";
    var clearDataClass = ".<?= GRF::CLEAR_DATA_CLASS ?>";
    $(degreeElement).change(function () {
        selected = $(degreeElement).val();
        career = tree[selected];
        options = "";
        $.each(career, function (key, value) {
            options = options + "<option value=\"" + key + "\">" + value + "</option>";
        });
        $(pensumElement).html(options);
        $(pensumElement).val("");
    });
    $(degreeElement).trigger("change");
    //PENSUM - COHORT DYNAMIC CHANGE
    var tree2 = <?= $form->getJsPensumCohortTree() ?>;
    var cohortElement = "#<?= GRF::COHORT ?>";
    $(pensumElement).change(function () {
        selected = $(pensumElement).val();
        cohort = tree2[selected];
        options = "";
        $.each(cohort, function (key, value) {
            options = options + "<option value=\"" + key + "\">" + value + "</option>";
        });
//        for (var key in cohort) {
//            options = options + "<option value=\"" + key + "\">" + cohort[key] + "</option>";
//        }
        $(cohortElement).html(options);
        if (selected != "<?= GRF::UPG_COURSE_CODE ?>") {
            $(cohortElement).val("");
        }
    });
    $(pensumElement).trigger("change");
