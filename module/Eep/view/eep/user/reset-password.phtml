<?php
// Vista para el formulario de restablecimiento de contraseña
/** @var \Eep\Form\ResetPasswordForm $form */
/** @var \Eep\ValueObject\Message|null $msg */
?>
<div class="container">
    <h2>Restablecer contraseña</h2>
    <?php if (isset($msg) && $msg): ?>
        <div class="alert alert-<?php echo strtolower($msg->getType()); ?>">
            <strong><?php echo $msg->getTitle(); ?></strong><br>
            <?php echo $msg->getMessage(); ?>
        </div>
    <?php endif; ?>
    <?php if (isset($form) && $form): ?>
        <form method="post">
            <div class="form-group">
                <?php echo $this->formLabel($form->get('password')); ?>
                <?php echo $this->formElement($form->get('password')); ?>
                <?php $passwordErrors = $this->formElementErrors($form->get('password')); ?>
                <?php if (!empty($passwordErrors)): ?>
                    <div class="alert alert-danger" style="margin-top:5px;padding:5px 10px;">
                        <font color="red"><?php echo $passwordErrors; ?></font>
                    </div>
                <?php endif; ?>
            </div>
            <div class="form-group">
                <?php echo $this->formLabel($form->get('confirm_password')); ?>
                <?php echo $this->formElement($form->get('confirm_password')); ?>
                <?php $confirmErrors = $this->formElementErrors($form->get('confirm_password')); ?>
                <?php if (!empty($confirmErrors)): ?>
                    <div class="alert alert-danger" style="margin-top:5px;padding:5px 10px;">
                        <font color="red"><?php echo $confirmErrors; ?></font>
                    </div>
                <?php endif; ?>
            </div>
            <div class="form-group">
                <?php echo $this->formElement($form->get('submit')); ?>
            </div>
        </form>
    <?php endif; ?>
</div>
