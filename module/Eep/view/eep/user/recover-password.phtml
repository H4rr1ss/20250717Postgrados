<?php
// Vista para el formulario de recuperación de contraseña
/** @var \Eep\Form\RecoverPasswordForm $form */
/** @var \Eep\ValueObject\Message|null $msg */
?>
<div class="container">
    <h2>Recuperar contraseña</h2>
    <?php if (isset($msg) && $msg): ?>
        <div class="alert alert-<?php echo strtolower($msg->getType()); ?>">
            <strong><?php echo $msg->getTitle(); ?></strong><br>
            <?php echo $msg->getMsg(); ?>
        </div>
    <?php endif; ?>
    <form method="post">
        <div class="form-group">
            <?php echo $this->formLabel($form->get('email')); ?>
            <?php echo $this->formElement($form->get('email')); ?>
            <?php echo $this->formElementErrors($form->get('email')); ?>
        </div>
        <div class="form-group">
            <?php echo $this->formElement($form->get('submit')); ?>
        </div>
    </form>
</div>
