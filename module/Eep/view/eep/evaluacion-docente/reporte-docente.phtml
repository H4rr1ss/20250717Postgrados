<?php
$this->headTitle('Reporte de Evaluación Docente');
$periodos = $periodos ?? [];
$reporte = $reporte ?? [];
$anio = $anio ?? null;
$mes = $mes ?? null;

$nombresMeses = [
    1 => 'Enero', 2 => 'Febrero', 3 => 'Marzo', 4 => 'Abril',
    5 => 'Mayo', 6 => 'Junio', 7 => 'Julio', 8 => 'Agosto',
    9 => 'Septiembre', 10 => 'Octubre', 11 => 'Noviembre', 12 => 'Diciembre'
];

$anios = [];
$meses = [];
foreach ($periodos as $p) {
    $anios[(int) $p['anio']] = $p['anio'];
    $meses[(int) $p['mes']] = $p['mes'];
}
rsort($anios);
ksort($meses);
?>
<div class="col-lg-12">
    <div class="panel panel-green">
        <div class="panel-heading">
            Reporte de Evaluación Docente
            <small>— Período del Curso</small>
        </div>
        <div class="panel-body">
            <div class="row">
                <form method="get" action="<?= $this->url('evaluacion-docente', ['action' => 'reporte-docente']) ?>">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Año</label>
                            <select name="anio" class="form-control">
                                <option value="">Todos</option>
                                <?php foreach ($anios as $a): ?>
                                    <option value="<?= $this->escapeHtml($a) ?>" <?= $anio == $a ? 'selected' : '' ?>>
                                        <?= $this->escapeHtml($a) ?>
                                    </option>
                                <?php endforeach; ?>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Mes</label>
                            <select name="mes" class="form-control">
                                <option value="">Todos</option>
                                <?php foreach ($meses as $m): ?>
                                    <option value="<?= $this->escapeHtml($m) ?>" <?= $mes == $m ? 'selected' : '' ?>>
                                        <?= $this->escapeHtml($nombresMeses[(int) $m] ?? $m) ?>
                                    </option>
                                <?php endforeach; ?>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <br/>
                        <button type="submit" class="btn btn-blue">
                            <i class="fa fa-filter"></i> Filtrar
                        </button>
                        <a href="<?= $this->url('evaluacion-docente', ['action' => 'descargar-reporte-docente'], ['query' => ['anio' => $anio, 'mes' => $mes]]) ?>"
                           class="btn btn-success">
                            <i class="fa fa-download"></i> Descargar CSV
                        </a>
                    </div>
                </form>
            </div>
            <hr/>
            <?= $this->partial('eep/msg', ['msg' => $msg ?? null]) ?>
            <div class="overflow-x">
                <table class="table table-hover table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Docente</th>
                            <th>Curso</th>
                            <th class="text-center">Sección</th>
                            <th class="text-center">Período del Curso</th>
                            <th class="text-center">Evaluaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if (!empty($reporte)): ?>
                            <?php foreach ($reporte as $item): ?>
                                <tr>
                                    <td><?= $this->escapeHtml($item['nombre_docente']) ?></td>
                                    <td><?= $this->escapeHtml($item['nombre_curso']) ?></td>
                                    <td class="text-center"><?= $this->escapeHtml($item['seccion']) ?></td>
                                    <td class="text-center"><?= $this->escapeHtml($item['anio'] . ' - ' . ($nombresMeses[(int) $item['mes']] ?? 'Mes ' . $item['mes'])) ?></td>
                                    <td class="text-center"><?= $this->escapeHtml($item['total_evaluaciones']) ?></td>
                                </tr>
                            <?php endforeach; ?>
                        <?php else: ?>
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No hay evaluaciones registradas para el período seleccionado.
                                </td>
                            </tr>
                        <?php endif; ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
