<script>
document.getElementById('form-evaluacion').addEventListener('submit', function(e) {
    let todasRespondidas = true;
    let primerCampoFaltante = null;

    // Validar todos los inputs radio requeridos (escala10 y boolean)
    const radioGroups = {};
    document.querySelectorAll('input[type="radio"][required]').forEach(function(input) {
        radioGroups[input.name] = radioGroups[input.name] || [];
        radioGroups[input.name].push(input);
    });

    for (let nombre in radioGroups) {
        if (radioGroups.hasOwnProperty(nombre)) {
            const grupoRespondido = radioGroups[nombre].some(function(input) {
                return input.checked;
            });
            if (!grupoRespondido) {
                todasRespondidas = false;
                if (!primerCampoFaltante) {
                    primerCampoFaltante = radioGroups[nombre][0];
                }
            }
        }
    }

    // Validar textareas requeridos
    document.querySelectorAll('textarea[required]').forEach(function(textarea) {
        if (!textarea.value.trim()) {
            todasRespondidas = false;
            if (!primerCampoFaltante) {
                primerCampoFaltante = textarea;
            }
        }
    });

    if (!todasRespondidas) {
        e.preventDefault();
        alert('Por favor, responda todas las preguntas obligatorias antes de enviar la evaluación.');
        if (primerCampoFaltante) {
            primerCampoFaltante.scrollIntoView({ behavior: 'smooth', block: 'center' });
            primerCampoFaltante.focus();
        }
        return false;
    }

    const confirmacion = confirm('¿Está seguro de enviar esta evaluación?\n\nUna vez enviada, no podrá modificarla.');
    if (!confirmacion) {
        e.preventDefault();
        return false;
    }

    document.getElementById('btn-enviar').disabled = true;
    document.getElementById('btn-enviar').innerHTML = '<i class="fa fa-spinner fa-spin"></i> Enviando...';
});
</script>
