<style>
/* Estilos para el formulario de evaluación */
.rating-container {
    margin-top: 10px;
}

.rating-scale {
    display: flex;
    justify-content: flex-start;
    gap: 15px;
    margin-bottom: 5px;
}

.rating-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    padding: 10px 15px;
    border: 2px solid #ddd;
    border-radius: 5px;
    transition: all 0.2s ease;
    background-color: white;
    min-width: 50px;
}

.rating-option:hover {
    border-color: #337ab7;
    background-color: #f0f8ff;
}

.rating-option input[type="radio"] {
    margin: 0;
    margin-bottom: 5px;
}

.rating-number {
    font-size: 18px;
    font-weight: bold;
    color: #333;
}

.rating-option input[type="radio"]:checked ~ .rating-number {
    color: #337ab7;
}

.rating-option:has(input[type="radio"]:checked) {
    border-color: #337ab7;
    background-color: #e7f3ff;
}

.form-group {
    border-radius: 5px;
}

.panel-body {
    padding: 20px;
}

/* Responsive */
@media (max-width: 768px) {
    .rating-scale {
        gap: 8px;
    }
    
    .rating-option {
        padding: 8px 10px;
        min-width: 40px;
    }
    
    .rating-number {
        font-size: 16px;
    }
    
    .rating-labels {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
}

/* Animación al enviar */
#btn-enviar:hover {
    transform: scale(1.05);
    transition: transform 0.2s ease;
}
</style>

<script>
// Validación del formulario antes de enviar
document.getElementById('form-evaluacion').addEventListener('submit', function(e) {
    const preguntasRequeridas = document.querySelectorAll('input[type="radio"][required]');
    const grupos = {};
    
    // Agrupar por nombre
    preguntasRequeridas.forEach(input => {
        grupos[input.name] = grupos[input.name] || [];
        grupos[input.name].push(input);
    });
    
    // Verificar que cada grupo tenga al menos una opción marcada
    let todasRespondidas = true;
    for (let nombre in grupos) {
        const grupoRespondido = grupos[nombre].some(input => input.checked);
        if (!grupoRespondido) {
            todasRespondidas = false;
            break;
        }
    }
    
    if (!todasRespondidas) {
        e.preventDefault();
        alert('Por favor, responda todas las preguntas obligatorias antes de enviar la evaluación.');
        return false;
    }
    
    // Confirmación final
    const confirmacion = confirm('¿Está seguro de enviar esta evaluación?\n\nUna vez enviada, no podrá modificarla.');
    if (!confirmacion) {
        e.preventDefault();
        return false;
    }
    
    // Deshabilitar botón para evitar doble envío
    document.getElementById('btn-enviar').disabled = true;
    document.getElementById('btn-enviar').innerHTML = '<i class="fa fa-spinner fa-spin"></i> Enviando...';
});
</script>
