                <div class="alert alert-info">
                    <?= $message->getMessage() ?>
                </div>
            <?php endif; ?>
            <form method="post" enctype="multipart/form-data" action="<?= $this->url('admisiones') ?>" id="form-publico">
                <div id="cui-mensaje" class="alert alert-danger" style="display:none;"></div>
