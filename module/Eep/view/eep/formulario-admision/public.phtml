<script>
(function() {
    const cuiInput = document.getElementById('cui');
    const cuiMensaje = document.getElementById('cui-mensaje');
    const form = document.getElementById('form-publico');

    const cuiMensajeTexto = document.getElementById('cui-mensaje-texto');

    if (cuiInput && cuiMensaje && cuiMensajeTexto) {
        let timeout = null;

        cuiInput.addEventListener('blur', function() {
            const cui = cuiInput.value.trim();
            if (cui.length === 0) {
                cuiMensaje.style.display = 'none';
                return;
            }

            clearTimeout(timeout);
            timeout = setTimeout(function() {
                const xhr = new XMLHttpRequest();
                xhr.open('POST', '<?= $this->url('verificar-cui') ?>', true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4 && xhr.status === 200) {
                        try {
                            const resp = JSON.parse(xhr.responseText);
                            if (!resp.disponible) {
                                cuiMensajeTexto.textContent = resp.mensaje || 'Este DPI/CUI ya tiene una respuesta registrada.';
                                cuiMensaje.style.display = 'block';
                            } else {
                                cuiMensaje.style.display = 'none';
                            }
                        } catch (e) {
                            cuiMensaje.style.display = 'none';
                        }
                    }
                };
                xhr.send('cui=' + encodeURIComponent(cui));
            }, 300);
        });

        cuiInput.addEventListener('input', function() {
            cuiMensaje.style.display = 'none';
        });

        if (form) {
            form.addEventListener('submit', function(e) {
                if (cuiMensaje.style.display === 'block') {
                    e.preventDefault();
                    alert(cuiMensajeTexto.textContent);
                    return false;
                }
            });
        }
    }

    // Validación condicional: CUI/Pasaporte según nacionalidad
    const nacionalidadSelect = document.getElementById('nacionalidad');
    const pasaporteInput = document.getElementById('pasaporte');
    const codGuatemala = '<?= $this->codGuatemala ?>';

    function ajustarRequiredDocumentos() {
        if (!nacionalidadSelect) return;
        const esGuatemala = (nacionalidadSelect.value === codGuatemala);
        if (cuiInput) {
            cuiInput.required = esGuatemala;
        }
        if (pasaporteInput) {
            pasaporteInput.required = !esGuatemala;
        }
    }

    if (nacionalidadSelect) {
        nacionalidadSelect.addEventListener('change', ajustarRequiredDocumentos);
        ajustarRequiredDocumentos();
    }

    // Validación condicional: campos laborales obligatorios si trabaja_actualmente == yes
    const laboraRadios = document.querySelectorAll('input[name="trabaja_actualmente"]');
    const ubicacionLaboral = document.getElementById('ubicacion_laboral');
    const horaInicio = document.getElementById('hora_inicio');
    const horaFin = document.getElementById('hora_fin');
    const diasLaboraCheckboxes = document.querySelectorAll('input[name="dias_labora[]"]');

    function ajustarRequiredLaboral() {
        const laboraYes = Array.from(laboraRadios).some(function(r) { return r.checked && r.value === 'yes'; });
        if (ubicacionLaboral) {
            ubicacionLaboral.required = laboraYes;
        }
        if (horaInicio) {
            horaInicio.required = laboraYes;
        }
        if (horaFin) {
            horaFin.required = laboraYes;
        }
        diasLaboraCheckboxes.forEach(function(cb) {
            cb.required = laboraYes;
        });
    }

    if (laboraRadios.length > 0) {
        laboraRadios.forEach(function(r) {
            r.addEventListener('change', ajustarRequiredLaboral);
        });
        ajustarRequiredLaboral();
    }

    // Cascada grado -> carrera
    const gradoSelect = document.getElementById('grado_a_ingresar');
    const carreraSelect = document.getElementById('carrera_a_ingresar');
    const careerTree = <?= json_encode($careerTree ?? []) ?>;

    if (gradoSelect && carreraSelect) {
        function filtrarCarreras() {
            const gradoId = gradoSelect.value;
            const carreras = careerTree[gradoId] || {};
            let options = '<option value="">-- Seleccione --</option>';
            for (const cod in carreras) {
                options += '<option value="' + cod + '">' + carreras[cod] + '</option>';
            }
            carreraSelect.innerHTML = options;
        }
        gradoSelect.addEventListener('change', filtrarCarreras);
        // Inicializar con el primer grado si está seleccionado
        if (gradoSelect.value) {
            filtrarCarreras();
        }
    }

    // Wizard navigation
    (function() {
        const steps = document.querySelectorAll('.wizard-step');
        const btnAnterior = document.getElementById('btn-anterior');
        const btnSiguiente = document.getElementById('btn-siguiente');
        const btnEnviar = document.getElementById('btn-enviar');
        let currentStep = 0;
        const totalSteps = steps.length;

        function showStep(n) {
            steps.forEach(function(s, i) {
                s.classList.toggle('active', i === n);
            });
            currentStep = n;
            btnAnterior.style.display = (n === 0) ? 'none' : 'inline-block';
            if (n === totalSteps - 1) {
                btnSiguiente.style.display = 'none';
                btnEnviar.style.display = 'inline-block';
            } else {
                btnSiguiente.style.display = 'inline-block';
                btnEnviar.style.display = 'none';
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function validateStep(n) {
            const step = steps[n];
            if (!step) return true;

            // Limpiar errores previos del paso actual
            step.querySelectorAll('.campo-invalido').forEach(function(el) {
                el.classList.remove('campo-invalido');
            });

            const fields = step.querySelectorAll('input, select, textarea');
            let firstInvalid = null;
            let invalidCount = 0;
            let isValid = true;
            const invalidLabels = [];

            fields.forEach(function(field) {
                let fieldValid = true;
                if (field.type === 'checkbox' || field.type === 'radio') {
                    const name = field.name;
                    const group = step.querySelectorAll('[name="' + name + '"]');
                    const anyChecked = Array.from(group).some(function(g) { return g.checked; });
                    const isRequired = group[0] && group[0].required;
                    if (isRequired && !anyChecked) {
                        fieldValid = false;
                        if (!firstInvalid) firstInvalid = group[0];
                    }
                } else {
                    if (field.required && !field.value.trim()) {
                        fieldValid = false;
                        if (!firstInvalid) firstInvalid = field;
                    }
                }

                if (!fieldValid) {
                    isValid = false;
                    invalidCount++;
                    // Buscar el .form-group ancestro para marcarlo
                    const group = field.closest('.form-group');
                    if (group) {
                        group.classList.add('campo-invalido');
                        const label = group.querySelector('label');
                        if (label && !invalidLabels.includes(label.textContent.trim())) {
                            invalidLabels.push(label.textContent.trim());
                        }
                    }
                }
            });

            // Validación condicional: información laboral obligatoria si trabaja_actualmente == yes
            const trabajaYes = step.querySelector('input[name="trabaja_actualmente"][value="yes"]:checked');
            if (trabajaYes) {
                const laboralIds = ['ubicacion_laboral', 'hora_inicio', 'hora_fin'];
                laboralIds.forEach(function(id) {
                    const el = step.querySelector('#' + id);
                    if (el && !el.value.trim()) {
                        isValid = false;
                        invalidCount++;
                        const group = el.closest('.form-group');
                        if (group && !group.classList.contains('campo-invalido')) {
                            group.classList.add('campo-invalido');
                            const label = group.querySelector('label');
                            if (label && !invalidLabels.includes(label.textContent.trim())) {
                                invalidLabels.push(label.textContent.trim());
                            }
                        }
                        if (!firstInvalid) firstInvalid = el;
                    }
                });
                const diasChecked = step.querySelectorAll('input[name="dias_labora[]"]:checked');
                if (diasChecked.length === 0) {
                    isValid = false;
                    invalidCount++;
                    const firstCb = step.querySelector('input[name="dias_labora[]"]');
                    const group = firstCb ? firstCb.closest('.form-group') : null;
                    if (group && !group.classList.contains('campo-invalido')) {
                        group.classList.add('campo-invalido');
                        const label = group.querySelector('label');
                        if (label && !invalidLabels.includes(label.textContent.trim())) {
                            invalidLabels.push(label.textContent.trim());
                        }
                    }
                    if (!firstInvalid && firstCb) firstInvalid = firstCb;
                }
            }

            if (!isValid && firstInvalid) {
                firstInvalid.focus();
                const msg = invalidCount === 1
                    ? 'Complete el campo resaltado antes de continuar.'
                    : 'Complete los ' + invalidCount + ' campos resaltados en rojo antes de continuar.';
                ToastService.warning(msg);
            }
            return isValid;
        }

        // Limpiar borde rojo al interactuar con el campo
        form.addEventListener('input', function(e) {
            const group = e.target.closest('.campo-invalido');
            if (group) {
                group.classList.remove('campo-invalido');
            }
        });
        form.addEventListener('change', function(e) {
            const group = e.target.closest('.campo-invalido');
            if (group) {
                group.classList.remove('campo-invalido');
            }
        });

        if (btnSiguiente) {
            btnSiguiente.addEventListener('click', function() {
                if (validateStep(currentStep)) {
                    showStep(currentStep + 1);
                }
            });
        }

        if (btnAnterior) {
            btnAnterior.addEventListener('click', function() {
                if (currentStep > 0) {
                    showStep(currentStep - 1);
                }
            });
        }

        // Initialize: mark first step active
        showStep(0);
    })();
})();
</script>
