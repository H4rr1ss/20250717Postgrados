function renderCampo($campo, $nationalities, $degrees, $careers, $cohorts) {
    $nombre = $campo->getNombreCampo();
    $etiqueta = $campo->getEtiqueta();
    $requerido = $campo->getRequerido();
    $tipo = $campo->getTipoCampo();
    $opciones = $campo->getOpciones();
    $opcionesArray = $campo->getOpcionesArray();
    ?>
    <div class="form-group">
        <label for="<?= $nombre ?>"><?= $etiqueta ?>
            <?php if ($requerido): ?><span class="text-danger">*</span><?php endif; ?>
        </label>
        <?php switch ($tipo):
            case 'texto': ?>
                <input type="text" class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>>
                <?php break;
            case 'email': ?>
                <input type="email" class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>>
                <?php break;
            case 'telefono': ?>
                <input type="tel" class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>>
                <?php break;
            case 'fecha': ?>
                <input type="date" class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>>
                <?php break;
            case 'time': ?>
                <input type="time" class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>>
                <?php break;
            case 'textarea': ?>
                <textarea class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>></textarea>
                <?php break;
            case 'boolean': ?>
                <div class="radio-list">
                    <label class="radio-inline">
                        <input type="radio" name="<?= $nombre ?>" value="yes" <?= $requerido ? 'required' : '' ?>> Sí
                    </label>
                    <label class="radio-inline">
                        <input type="radio" name="<?= $nombre ?>" value="no" <?= $requerido ? 'required' : '' ?>> No
                    </label>
                </div>
                <?php break;
            case 'multicheckbox': ?>
                <div class="checkbox-list">
                    <?php foreach (explode('|', $opciones ?: '') as $opt): ?>
                        <?php $opt = trim($opt); ?>
                        <?php if ($opt !== ''): ?>
                            <label class="checkbox-inline" style="margin-right: 15px;">
                                <input type="checkbox" name="<?= $nombre ?>[]" value="<?= $opt ?>">
                                <?= ucfirst($opt) ?>
                            </label>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </div>
                <?php break;
            case 'select': ?>
                <select class="form-control" name="<?= $nombre ?>" id="<?= $nombre ?>" <?= $requerido ? 'required' : '' ?>>
                    <option value="">-- Seleccione --</option>
                    <?php if ($nombre === 'nacionalidad' && !empty($nationalities)): ?>
                        <?php foreach ($nationalities as $pais): ?>
                            <option value="<?= $pais['cod_pais'] ?>"><?= $pais['nombre'] ?></option>
                        <?php endforeach; ?>
                    <?php elseif ($nombre === 'grado_a_ingresar' && !empty($degrees)): ?>
                        <?php foreach ($degrees as $grado): ?>
                            <option value="<?= $grado['cod_grado'] ?>"><?= $grado['nombre'] ?></option>
                        <?php endforeach; ?>
                    <?php elseif ($nombre === 'carrera_a_ingresar' && !empty($careers)): ?>
                        <?php foreach ($careers as $carrera): ?>
                            <option value="<?= $carrera['cod_carrera'] ?>" data-grado="<?= $carrera['cod_grado'] ?>"><?= $carrera['alias_actual'] ?></option>
                        <?php endforeach; ?>
                    <?php elseif ($nombre === 'cohorte' && !empty($cohorts)): ?>
                        <?php foreach ($cohorts as $cohorte): ?>
                            <option value="<?= $cohorte['fecha_cohorte'] ?>"><?= date('d/m/Y', strtotime($cohorte['fecha_cohorte'])) ?></option>
                        <?php endforeach; ?>
                    <?php elseif ($nombre === 'sexo'): ?>
                        <?php foreach (explode('|', $opciones ?: 'H|M') as $opt): ?>
                            <?php $opt = trim($opt); ?>
                            <option value="<?= $opt ?>"><?= ($opt === 'H' ? 'Hombre' : ($opt === 'M' ? 'Mujer' : $opt)) ?></option>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <?php foreach ($opcionesArray as $opt): ?>
                            <?php $opt = trim($opt); ?>
                            <?php if ($opt !== ''): ?>
                                <option value="<?= $opt ?>"><?= $opt ?></option>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </select>
                <?php break;
            case 'archivo':
                if ($nombre === 'adjunto_titulos') {
                    echo '<input type="file" class="form-control" name="' . $nombre . '" id="' . $nombre . '" accept="application/pdf" ' . ($requerido ? 'required' : '') . '>';
                    echo '<small class="form-text text-muted">Solo archivos PDF. Tamaño máximo: 10 MB. Adjunte fotocopia de títulos obtenidos o certificación general de cursos (anverso y reverso en un solo archivo PDF).</small>';
                } else {
                    echo '<input type="file" class="form-control" name="' . $nombre . '" id="' . $nombre . '" accept="image/jpeg,image/png,image/gif,application/pdf" ' . ($requerido ? 'required' : '') . '>';
                    echo '<small class="form-text text-muted">Formatos permitidos: JPG, JPEG, PNG, GIF, PDF. Máximo 5MB.</small>';
                }
                break;
        endswitch; ?>
    </div>
    <?php
}

function printWizardStep($secciones, $grupos, $map, $nationalities, $degrees, $careers, $cohorts) {
    // Verificar si hay al menos una sección con campos
    $tieneCampos = false;
    foreach ($secciones as $seccionKey) {
        if (!empty($grupos[$seccionKey])) {
            $tieneCampos = true;
            break;
        }
    }
    if (!$tieneCampos) return;
    ?>
    <div class="wizard-step">
        <?php foreach ($secciones as $seccionKey): ?>
            <?php if (empty($grupos[$seccionKey])) continue; ?>
            <?php $meta = $map[$seccionKey] ?? ['titulo' => $seccionKey, 'icono' => 'fa-circle', 'color' => '#666']; ?>
            <div class="form-section">
                <div class="form-section-header">
                    <i class="fa <?= $meta['icono'] ?>" style="color: <?= $meta['color'] ?>;"></i> <?= $meta['titulo'] ?>
                </div>
                <div class="form-section-body">
                    <?php foreach ($grupos[$seccionKey] as $campo): ?>
                        <?php renderCampo($campo, $nationalities, $degrees, $careers, $cohorts); ?>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
    <?php
}
