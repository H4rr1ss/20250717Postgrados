                <?php endforeach; ?>
                <button type="submit" class="btn btn-primary">Enviar</button>
            </form>
        </div>
    </div>
</div>

<script>
(function() {
    const cuiInput = document.getElementById('cui');
    const cuiMensaje = document.getElementById('cui-mensaje');
    const form = document.getElementById('form-publico');

    if (cuiInput && cuiMensaje) {
        let timeout = null;

        cuiInput.addEventListener('blur', function() {
            const cui = cuiInput.value.trim();
            if (cui.length === 0) {
                cuiMensaje.style.display = 'none';
                return;
            }

            // Pequeña demora para no saturar peticiones
            clearTimeout(timeout);
            timeout = setTimeout(function() {
                const xhr = new XMLHttpRequest();
                xhr.open('POST', '<?= $this->url('verificar-cui') ?>', true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4 && xhr.status === 200) {
                        try {
                            const resp = JSON.parse(xhr.responseText);
                            if (!resp.disponible) {
                                cuiMensaje.textContent = resp.mensaje || 'Este DPI/CUI ya tiene una respuesta registrada.';
                                cuiMensaje.style.display = 'block';
                            } else {
                                cuiMensaje.style.display = 'none';
                            }
                        } catch (e) {
                            cuiMensaje.style.display = 'none';
                        }
                    }
                };
                xhr.send('cui=' + encodeURIComponent(cui));
            }, 300);
        });

        // Ocultar mensaje al escribir de nuevo
        cuiInput.addEventListener('input', function() {
            cuiMensaje.style.display = 'none';
        });

        // Validar antes de enviar
        if (form) {
            form.addEventListener('submit', function(e) {
                if (cuiMensaje.style.display === 'block') {
                    e.preventDefault();
                    alert(cuiMensaje.textContent);
                    return false;
                }
            });
        }
    }
})();
</script>
