                                       name="<?= $campo->getNombreCampo() ?>"
                                       id="<?= $campo->getNombreCampo() ?>"
                                       <?= $campo->getRequerido() ? 'required' : '' ?>>
                                <?php break;
                            case 'email': ?>
                                <input type="email" class="form-control"
                                       name="<?= $campo->getNombreCampo() ?>"
                                       id="<?= $campo->getNombreCampo() ?>"
                                       <?= $campo->getRequerido() ? 'required' : '' ?>>
                                <?php break;
                            case 'telefono': ?>
                                <input type="tel" class="form-control"
                                       name="<?= $campo->getNombreCampo() ?>"
                                       id="<?= $campo->getNombreCampo() ?>"
                                       <?= $campo->getRequerido() ? 'required' : '' ?>>
                                <?php break;
                            case 'fecha': ?>
                                <input type="date" class="form-control"
                                       name="<?= $campo->getNombreCampo() ?>"
                                       id="<?= $campo->getNombreCampo() ?>"
                                       <?= $campo->getRequerido() ? 'required' : '' ?>>
                                <?php break;
                            case 'textarea': ?>
                                <textarea class="form-control"
                                          name="<?= $campo->getNombreCampo() ?>"
                                          id="<?= $campo->getNombreCampo() ?>"
                                          <?= $campo->getRequerido() ? 'required' : '' ?>></textarea>
                                <?php break;
