// Función para parsear opciones de select
function parsearOpciones($opciones) {
    if (empty($opciones)) return [];
    
    $resultado = [];
    if (strpos($opciones, '|') !== false) {
        $resultado = explode('|', $opciones);
    } elseif (strpos($opciones, ',') !== false) {
        $resultado = explode(',', $opciones);
    } else {
        $resultado = [$opciones];
    }
    
    // Limpiar espacios y filtrar vacíos
    return array_filter(array_map('trim', $resultado));
}
