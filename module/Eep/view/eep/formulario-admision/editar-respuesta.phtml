// Función para parsear opciones de select
function parsearOpciones($opciones) {
    if (empty($opciones)) return [];

    $resultado = [];
    if (strpos($opciones, '|') !== false) {
        $resultado = explode('|', $opciones);
    } elseif (strpos($opciones, ',') !== false) {
        $resultado = explode(',', $opciones);
    } else {
        $resultado = [$opciones];
    }

    // Limpiar espacios y filtrar vacíos
    return array_filter(array_map('trim', $resultado));
}

// Mapear tipos del formulario a tipos HTML válidos
function mapTipoHtml($tipoCampo) {
    $map = [
        'texto' => 'text',
        'email' => 'email',
        'telefono' => 'tel',
        'fecha' => 'date',
        'time' => 'time',
        'textarea' => 'textarea',
        'boolean' => 'radio',
        'select' => 'select',
        'archivo' => 'file',
        'multicheckbox' => 'checkbox',
    ];
    return $map[$tipoCampo] ?? 'text';
}

// Helper para renderizar un campo en modo edición o solo lectura
function renderCampoEditor($campo, $modoSoloLectura, $view, $nationalities = [], $degrees = [], $careers = [], $cohorts = []) {
    $valor = isset($campo['valor_respuesta']) ? $campo['valor_respuesta'] : '';
    $tipo = isset($campo['tipo_campo']) ? $campo['tipo_campo'] : 'texto';
    $idCampo = isset($campo['id_campo']) ? $campo['id_campo'] : 0;
    $nombreCampo = isset($campo['nombre_campo']) ? $campo['nombre_campo'] : '';
    $etiqueta = isset($campo['etiqueta']) ? $campo['etiqueta'] : '';
    $requerido = !empty($campo['requerido']);
    $opciones = isset($campo['opciones']) ? $campo['opciones'] : '';
    $archivoAdjunto = isset($campo['archivo_adjunto']) ? $campo['archivo_adjunto'] : '';
    $idResp = isset($campo['id_respuesta']) ? $campo['id_respuesta'] : 0;

    if ($modoSoloLectura) {
        // Modo Solo Lectura
        if ($tipo === 'boolean') {
            echo '<p class="form-control-static">';
            echo '<span class="label label-' . ($valor === 'yes' ? 'success' : 'default') . '">';
            echo ($valor === 'yes' ? 'Sí' : 'No');
            echo '</span></p>';
        } elseif ($tipo === 'archivo') {
            if ($archivoAdjunto) {
                if ($nombreCampo === 'photo_dpi') {
                    echo '<p class="form-control-static text-success"><i class="fa fa-check-circle"></i> <strong>Se cargó un documento.</strong></p>';
                }
                echo '<p class="form-control-static">';
                echo '<a href="' . $view->url('formulario-admision', ['action' => 'descargar', 'id' => $idResp], ['query' => ['campo' => $nombreCampo]]) . '" target="_blank" class="btn btn-sm btn-default">';
                echo '<i class="fa fa-file"></i> ' . $view->escapeHtml($archivoAdjunto);
                echo '</a></p>';
            } else {
                echo '<p class="form-control-static text-muted"><i>No se adjuntó archivo</i></p>';
            }
        } elseif ($tipo === 'textarea') {
            echo '<div class="well well-sm" style="margin-bottom: 0; background-color: #f9f9f9;">';
            echo nl2br($view->escapeHtml($valor ?: 'Sin información'));
            echo '</div>';
        } elseif ($nombreCampo === 'nacionalidad' && !empty($nationalities)) {
            $nombrePais = 'Sin información';
            foreach ($nationalities as $pais) {
                if (isset($pais['cod_pais']) && $pais['cod_pais'] == $valor) {
                    $nombrePais = $pais['nombre'] ?? 'País #' . $valor;
                    break;
                }
            }
            echo '<p class="form-control-static">' . $view->escapeHtml($nombrePais) . '</p>';
        } else {
            echo '<p class="form-control-static">' . $view->escapeHtml($valor ?: 'Sin información') . '</p>';
        }
    } else {
        // Modo Edición
        $htmlTipo = mapTipoHtml($tipo);
        $reqAttr = $requerido ? 'required' : '';
        $nameAttr = 'campo_' . $idCampo;

        if ($tipo === 'select') {
            echo '<select name="' . $nameAttr . '" class="form-control" ' . $reqAttr . '>';
            echo '<option value="">Seleccione una opción</option>';

            if ($nombreCampo === 'nacionalidad' && !empty($nationalities)) {
                foreach ($nationalities as $pais) {
                    $cod = $pais['cod_pais'] ?? '';
                    $nom = $pais['nombre'] ?? '';
                    $selected = ($valor == $cod) ? 'selected' : '';
                    echo '<option value="' . $view->escapeHtml($cod) . '" ' . $selected . '>' . $view->escapeHtml($nom) . '</option>';
                }
            } elseif ($nombreCampo === 'grado_a_ingresar' && !empty($degrees)) {
                foreach ($degrees as $grado) {
                    $cod = $grado['cod_grado'] ?? '';
                    $nom = $grado['nombre'] ?? '';
                    $selected = ($valor == $cod) ? 'selected' : '';
                    echo '<option value="' . $view->escapeHtml($cod) . '" ' . $selected . '>' . $view->escapeHtml($nom) . '</option>';
                }
            } elseif ($nombreCampo === 'carrera_a_ingresar' && !empty($careers)) {
                foreach ($careers as $carrera) {
                    $cod = $carrera['cod_carrera'] ?? '';
                    $nom = $carrera['alias_actual'] ?? '';
                    $selected = ($valor == $cod) ? 'selected' : '';
                    echo '<option value="' . $view->escapeHtml($cod) . '" ' . $selected . '>' . $view->escapeHtml($nom) . '</option>';
                }
            } elseif ($nombreCampo === 'cohorte' && !empty($cohorts)) {
                foreach ($cohorts as $cohorte) {
                    $fecha = $cohorte['fecha_cohorte'] ?? '';
                    $label = !empty($fecha) ? date('d/m/Y', strtotime($fecha)) : '';
                    $selected = ($valor == $fecha) ? 'selected' : '';
                    echo '<option value="' . $view->escapeHtml($fecha) . '" ' . $selected . '>' . $view->escapeHtml($label) . '</option>';
                }
                // Opción especial de curso de actualización
                $selectedUpg = ($valor == '(Cursos de Actualización)') ? 'selected' : '';
                echo '<option value="(Cursos de Actualización)" ' . $selectedUpg . '>(Cursos de Actualización)</option>';
            } else {
                $opcionesArray = parsearOpciones($opciones);
                foreach ($opcionesArray as $opcion) {
                    $selected = ($valor === $opcion) ? 'selected' : '';
                    echo '<option value="' . $opcion . '" ' . $selected . '>' . $view->escapeHtml($opcion) . '</option>';
                }
            }
            echo '</select>';
        } elseif ($tipo === 'textarea') {
            echo '<textarea name="' . $nameAttr . '" class="form-control" rows="3" ' . $reqAttr . '>' . $view->escapeHtml($valor) . '</textarea>';
        } elseif ($tipo === 'fecha') {
            echo '<input type="date" name="' . $nameAttr . '" class="form-control" value="' . $view->escapeHtml($valor) . '" ' . $reqAttr . '>';
        } elseif ($tipo === 'boolean') {
            echo '<div class="radio-list">';
            $checkedYes = ($valor === 'yes') ? 'checked' : '';
            $checkedNo  = ($valor === 'no') ? 'checked' : '';
            echo '<label class="radio-inline"><input type="radio" name="' . $nameAttr . '" value="yes" ' . $checkedYes . ' ' . $reqAttr . '> Sí</label>';
            echo '<label class="radio-inline"><input type="radio" name="' . $nameAttr . '" value="no" ' . $checkedNo . ' ' . $reqAttr . '> No</label>';
            echo '</div>';
        } elseif ($tipo === 'archivo') {
            if ($archivoAdjunto) {
                if ($nombreCampo === 'photo_dpi') {
                    echo '<p class="form-control-static text-success"><i class="fa fa-check-circle"></i> <strong>Se cargó un documento.</strong></p>';
                }
                echo '<p class="form-control-static">Archivo actual: <a href="' . $view->url('formulario-admision', ['action' => 'descargar', 'id' => $idResp], ['query' => ['campo' => $nombreCampo]]) . '" target="_blank">' . $view->escapeHtml($archivoAdjunto) . '</a></p>';
            }
            echo '<p class="text-muted small">Los documentos adjuntos no son editables.</p>';
        } elseif ($tipo === 'multicheckbox') {
            $diasSeleccionados = !empty($valor) ? explode(',', $valor) : [];
            $diasOpciones = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo'];
            echo '<div class="checkbox-list">';
            foreach ($diasOpciones as $dia) {
                $checked = in_array($dia, $diasSeleccionados) ? 'checked' : '';
                echo '<label class="checkbox-inline" style="margin-right: 15px;">';
                echo '<input type="checkbox" name="' . $nameAttr . '[]" value="' . $dia . '" ' . $checked . '> ' . ucfirst($dia);
                echo '</label>';
            }
            echo '</div>';
        } else {
            // text, email, tel, time, y cualquier otro tipo
            echo '<input type="' . $htmlTipo . '" name="' . $nameAttr . '" class="form-control" value="' . $view->escapeHtml($valor) . '" ' . $reqAttr . '>';
        }
    }
}
