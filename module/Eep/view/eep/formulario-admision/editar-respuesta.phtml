<script>
// Función para mostrar/ocultar campos laborales según si labora
function toggleCamposLaborales() {
    const laboraActualmente = document.querySelector('input[name*="labora_actualmente"]:checked');
    const camposLaborales = document.querySelectorAll('.campo-laboral');
    
    if (laboraActualmente && laboraActualmente.value === 'true') {
        camposLaborales.forEach(campo => {
            campo.disabled = false;
            campo.required = true;
        });
    } else {
        camposLaborales.forEach(campo => {
            campo.disabled = true;
            campo.required = false;
            campo.value = '';
        });
    }
}

// Ejecutar al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    toggleCamposLaborales();
});
</script>
