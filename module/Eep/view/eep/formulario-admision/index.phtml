<script>
function confirmarArchivarFormulario(btn) {
    const form = btn.closest('form');
    ConfirmService.confirm('¿Está seguro que desea deshabilitar este formulario? Una vez deshabilitado, ya no podrá recibir nuevas respuestas y las respuestas existentes pasarán a modo de solo lectura.', function() {
        form.submit();
    });
}

function confirmarEliminarFormulario(btn) {
    const form = btn.closest('form');
    const totalRespuestas = parseInt(form.getAttribute('data-respuestas')) || 0;
    let mensaje = '¿Está seguro que desea eliminar este formulario?';
    if (totalRespuestas > 0) {
        mensaje = 'Este formulario tiene ' + totalRespuestas + ' respuesta(s). ' + mensaje + ' Esta acción no se puede deshacer y también eliminará los archivos adjuntos.';
    } else {
        mensaje = mensaje + ' Esta acción no se puede deshacer.';
    }
    ConfirmService.confirm(mensaje, function() {
        form.submit();
    });
}

function copiarLinkFormulario() {
    const input = document.getElementById('link-formulario');
    if (!input) return;
    input.select();
    input.setSelectionRange(0, 99999); // Para móviles
    try {
        navigator.clipboard.writeText(input.value).then(function() {
            ConfirmService.alert('Enlace copiado al portapapeles.');
        });
    } catch (err) {
        // Fallback para navegadores sin Clipboard API
        document.execCommand('copy');
        ConfirmService.alert('Enlace copiado al portapapeles.');
    }
}
</script>

