<script>
function confirmarEliminarFormulario(btn) {
    const form = btn.closest('form');
    const totalRespuestas = parseInt(form.getAttribute('data-respuestas')) || 0;
    let mensaje = '¿Está seguro que desea eliminar este formulario?';
    if (totalRespuestas > 0) {
        mensaje = 'Este formulario tiene ' + totalRespuestas + ' respuesta(s). ' + mensaje + ' Esta acción no se puede deshacer y también eliminará los archivos adjuntos.';
    } else {
        mensaje = mensaje + ' Esta acción no se puede deshacer.';
    }
    ConfirmService.confirm(mensaje, function() {
        form.submit();
    });
}
</script>

