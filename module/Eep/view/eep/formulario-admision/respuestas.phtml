<script>
function toggleSelectAll() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.aspirante-checkbox');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = selectAll.checked;
    });
}

function registrarAspirantesSeleccionados() {
    const checkboxes = document.querySelectorAll('.aspirante-checkbox:checked');
    
    if (checkboxes.length === 0) {
        alert('Debe seleccionar al menos un aspirante para registrar.');
        return;
    }
    
    if (confirm(`¿Está seguro que desea registrar ${checkboxes.length} aspirante(s) como estudiantes en el sistema?`)) {
        document.getElementById('formRegistrarAspirantes').submit();
    }
}

function eliminarRespuesta(idRespuesta) {
    if (confirm('¿Está seguro que desea eliminar esta respuesta? Esta acción no se puede deshacer.')) {
        // Crear formulario temporal para eliminación
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = window.location.href;
        
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'eliminar_respuesta';
        input.value = idRespuesta;
        
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
