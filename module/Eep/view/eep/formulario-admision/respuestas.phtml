<script>
function toggleSelectAll() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.aspirante-checkbox:not(:disabled)');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = selectAll.checked;
    });
}

function registrarAspirantesSeleccionados() {
    const checkboxes = document.querySelectorAll('.aspirante-checkbox:checked');
    
    if (checkboxes.length === 0) {
        ConfirmService.alert('Debe seleccionar al menos un aspirante para registrar.');
        return;
    }

    const grado = document.getElementById('grado_a_ingresar').value;
    const carrera = document.getElementById('carrera_a_ingresar').value;
    const cohorte = document.getElementById('cohorte').value;

    if (!grado || !carrera || !cohorte) {
        ConfirmService.alert('Debe seleccionar grado, carrera y cohorte antes de registrar.');
        return;
    }

    ConfirmService.confirm('¿Está seguro que desea registrar ' + checkboxes.length + ' aspirante(s) como estudiantes en el sistema?', function() {
        // Agregar input hidden para indicar la acción de asignación masiva
        const form = document.getElementById('formRegistrarAspirantes');
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'registrar_seleccionados';
        hidden.value = '1';
        form.appendChild(hidden);
        form.submit();
    });
}

function eliminarRespuesta(idRespuesta) {
    ConfirmService.confirm('¿Está seguro que desea eliminar esta respuesta? Esta acción no se puede deshacer.', function() {
        // Crear formulario temporal para eliminación
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = window.location.href;
        
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'eliminar_respuesta';
        input.value = idRespuesta;
        
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    });
}

// Cascada Grado -> Carrera en el panel de asignación masiva
(function() {
    const gradoSelect = document.getElementById('grado_a_ingresar');
    const carreraSelect = document.getElementById('carrera_a_ingresar');
    const careerTree = <?= json_encode($careerTree ?? []) ?>;

    function filtrarCarreras() {
        const gradoId = gradoSelect.value;
        const carreras = careerTree[gradoId] || {};
        let options = '<option value="">-- Seleccione --</option>';
        for (const cod in carreras) {
            options += '<option value="' + cod + '">' + carreras[cod] + '</option>';
        }
        carreraSelect.innerHTML = options;
    }

    if (gradoSelect && carreraSelect) {
        gradoSelect.addEventListener('change', filtrarCarreras);
    }
})();
</script>
