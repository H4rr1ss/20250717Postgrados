// Helper para renderizar el valor de un campo según su tipo/nombre
function renderCampoValor($campo, $nationalities = []) {
    $nombre = $campo['nombre_campo'];
    $valor = $campo['valor_respuesta'];
    $tipo  = $campo['tipo_campo'];

    if ($nombre === 'sexo') {
        echo '<span class="label label-default">' . (($valor === 'H') ? 'Hombre' : (($valor === 'M') ? 'Mujer' : htmlspecialchars($valor))) . '</span>';
    } elseif ($nombre === 'nacionalidad') {
        $nombrePais = '—';
        foreach ($nationalities as $pais) {
            if (isset($pais['cod_pais']) && $pais['cod_pais'] == $valor) {
                $nombrePais = $pais['nombre'] ?? 'País #' . $valor;
                break;
            }
        }
        echo htmlspecialchars($nombrePais);
    } elseif ($nombre === 'correo_electronico') {
        echo '<a href="mailto:' . htmlspecialchars($valor) . '">' . htmlspecialchars($valor) . '</a>';
    } elseif ($nombre === 'telefono') {
        echo '<a href="tel:' . htmlspecialchars($valor) . '"><i class="fa fa-phone"></i> ' . htmlspecialchars($valor) . '</a>';
    } elseif ($tipo === 'boolean') {
        echo '<span class="label label-' . (($valor === 'yes') ? 'success' : 'default') . '">' . (($valor === 'yes') ? 'Sí' : 'No') . '</span>';
    } elseif ($nombre === 'dias_labora') {
        echo htmlspecialchars($valor ? str_replace(',', ', ', $valor) : '—');
    } elseif ($tipo === 'textarea') {
        echo nl2br(htmlspecialchars($valor ?: '—'));
    } else {
        echo htmlspecialchars($valor ?: '—');
    }
}

// Extraer datos clave para el header
$nombreCompleto = '';
$cui = '';
$correo = '';
$telefono = '';
$photoDpiUrl = null;
$photoDpiNombre = null;
foreach ($respuesta as $campo) {
    switch ($campo['nombre_campo']) {
        case 'nombres':
            $nombreCompleto = $campo['valor_respuesta'];
            break;
        case 'apellidos':
            $nombreCompleto .= ' ' . $campo['valor_respuesta'];
            break;
        case 'cui':
            $cui = $campo['valor_respuesta'];
            break;
        case 'correo_electronico':
            $correo = $campo['valor_respuesta'];
            break;
        case 'telefono':
            $telefono = $campo['valor_respuesta'];
            break;
        case 'photo_dpi':
            if (!empty($campo['archivo_adjunto'])) {
                $photoDpiUrl = $this->url('formulario-admision', ['action' => 'descargar', 'id' => $campo['id_respuesta']], ['query' => ['campo' => 'photo_dpi']]);
                $photoDpiNombre = $campo['archivo_adjunto'];
            }
            break;
    }
}
